import { TdnPage } from "../page.slint";
import { Lang, Dir, Keymap } from "../lang.slint";
import { ListView, ScrollView } from "std-widgets.slint";
import { TdnInput, TdnListRow, TdnText, Modal } from "../components.slint";
import { Icon } from "../slintcn/components/icon.slint";
import { LucidePaths } from "../slintcn/components/lucide-paths.slint";
import { FocusRing } from "../slintcn/components/focus-ring.slint";
import { Ims } from "../ims.slint";
import { Tokens } from "../slintcn/theme/tokens.slint";
import { Card } from "../slintcn/components/card.slint";
import { Separator } from "../slintcn/components/separator.slint";

// a row like the toggles elsewhere that says which input methods are on and opens the dialog to
// change them
component ImsRow inherits Rectangle {
    property <bool> pointer-focus;
    property <string> value: Ims.enabled == "" ? Lang.t("page-keyboard-ims-none", []) : Ims.enabled;

    forward-focus: focus;
    accessible-role: button;
    accessible-label: Lang.t("page-keyboard-ims", []) + ", " + root.value;
    accessible-action-default => { Ims.open = true; }

    vertical-stretch: 0;
    height: 2.75rem;
    border-radius: Tokens.radius-lg;
    border-width: 1px;
    border-color: Tokens.color-border-hairline-strong;
    background: area.has-hover ? Tokens.color-accent : Tokens.color-card;
    animate background { duration: Tokens.motion-fast; }

    focus := FocusScope {
        enabled: !Modal.open;
        key-pressed(event) => {
            root.pointer-focus = false;
            if event.text == Key.Return || event.text == " " {
                if !event.repeat { Ims.open = true; }
                return accept;
            }
            reject
        }
    }

    HorizontalLayout {
        padding-left: 1rem;
        padding-right: 0.75rem;
        spacing: 0.5rem;

        TdnText {
            text: Lang.t("page-keyboard-ims", []);
            horizontal-alignment: Dir.text-start;
            horizontal-stretch: 0;
            font-weight: Tokens.typography-weight-medium;
            accessible-role: none;
        }

        TdnText {
            layout-order: Dir.order(1);
            text: root.value;
            horizontal-alignment: Dir.text-end;
            horizontal-stretch: 1;
            overflow: elide;
            color: Tokens.color-muted-foreground;
            accessible-role: none;
        }

        // points the way the language reads
        VerticalLayout {
            layout-order: Dir.order(2);
            alignment: center;

            Icon {
                commands: Lang.rtl ? LucidePaths.chevron-left : LucidePaths.chevron-right;
                size: 1.1rem;
                tint: Tokens.color-muted-foreground;
                stroke-width: 2px;
            }
        }
    }

    area := TouchArea {
        mouse-cursor: pointer;
        pointer-event(ev) => {
            if ev.kind == PointerEventKind.down { root.pointer-focus = true; }
        }
        clicked => { Ims.open = true; }
    }

    if focus.has-focus && !root.pointer-focus: FocusRing {
        host-width: parent.width;
        host-height: parent.height;
        radius: Tokens.radius-lg + self.offset;
    }
}

export component KeyboardPage inherits TdnPage {
    pageid: "keyboard";
    show-steps: false;
    forward-focus: search-layout;

    property <length> row-height: 2.25rem;
    // rows moved to with the arrow keys, -1 until the user does so. They're only highlighted, Enter
    // or a click applies them, since applying a layout changes what typing in the search does
    // (e.g. Cyrillic after passing Russian)
    property <int> layout-cursor: -1;
    // 0 is the "Default" row, `n` is `Lang.variants[n - 1]`
    property <int> variant-cursor: -1;
    // rows of the current layout and variant, -1 if they're filtered out, see the finders below
    property <int> current-layout-row: -1;
    property <int> current-variant-row: -1;
    // what Enter picks when the search filtered out the current layout and the arrow keys weren't
    // used: the first match
    property <bool> first-layout-match: search-layout.text != "" && layout-cursor < 0
        && current-layout-row < 0 && Lang.keymaps.length > 0;

    function select-keymap(keymap: Keymap) {
        if keymap.id != Lang.current_keymap.id {
            search-variant.text = "";
            variant-cursor = -1;
            variants.content-y = 0;
        }
        Lang.select_keymap(keymap);
    }

    function select-variant(i: int) {
        variant-cursor = i;
        Lang.select_variant(i == 0 ? { id: "", name: "" } : Lang.variants[i - 1]);
    }

    function move-layout-cursor(delta: int) {
        if Lang.keymaps.length == 0 { return; }
        // start from the current layout, so the first press moves away from it instead of
        // jumping to the top of the list and applying that
        if layout-cursor < 0 && current-layout-row >= 0 && current-layout-row < Lang.keymaps.length
            && Lang.keymaps[current-layout-row].id == Lang.current_keymap.id {
            layout-cursor = current-layout-row;
        }
        layout-cursor = max(0, min(Lang.keymaps.length - 1, layout-cursor + delta));
        let top = layout-cursor * row-height;
        if top < -layouts.content-y {
            layouts.content-y = -top;
        } else if top + row-height > -layouts.content-y + layouts.visible-height {
            layouts.content-y = layouts.visible-height - top - row-height;
        }
    }

    function move-variant-cursor(delta: int) {
        if variant-cursor < 0 {
            if Lang.current_variant.id == "" {
                variant-cursor = 0;
            } else if current-variant-row >= 0 && current-variant-row < Lang.variants.length
                && Lang.variants[current-variant-row].id == Lang.current_variant.id {
                variant-cursor = current-variant-row + 1;
            }
        }
        variant-cursor = max(0, min(Lang.variants.length, variant-cursor + delta));
        let top = variant-cursor * row-height;
        if top < -variants.content-y {
            variants.content-y = -top;
        } else if top + row-height > -variants.content-y + variants.visible-height {
            variants.content-y = variants.visible-height - top - row-height;
        }
    }

    Card {
        variant: solid;
        vertical-stretch: 1;

        // find the current layout's and variant's rows for the arrow keys to start from, the
        // layouts' `ListView` only creates the rows in view so its rows can't tell
        for keymap[i] in Lang.keymaps: Rectangle {
            property <bool> current: keymap.id == Lang.current_keymap.id;
            width: 0;
            height: 0;
            init => { if self.current { root.current-layout-row = i; } }
            changed current => {
                if self.current { root.current-layout-row = i; }
                else if root.current-layout-row == i { root.current-layout-row = -1; }
            }
        }

        for variant[i] in Lang.variants: Rectangle {
            property <bool> current: variant.id == Lang.current_variant.id;
            width: 0;
            height: 0;
            init => { if self.current { root.current-variant-row = i; } }
            changed current => {
                if self.current { root.current-variant-row = i; }
                else if root.current-variant-row == i { root.current-variant-row = -1; }
            }
        }

        HorizontalLayout {
            padding: 1rem;
            spacing: 1rem;

            VerticalLayout {
                spacing: 0.75rem;
                horizontal-stretch: 1;

                search-layout := TdnInput {
                    placeholder: Lang.t("page-keyboard-search-layout", []);
                    icon: @image-url("../../data/icons/system-search-symbolic.svg");
                    // the arrow keys move through the layouts while the focus stays here, so screen
                    // readers hear about it from the description changing
                    description: root.layout-cursor >= 0 && root.layout-cursor < Lang.keymaps.length
                        ? Lang.keymaps[root.layout-cursor].name
                        : root.first-layout-match ? Lang.keymaps[0].name : Lang.current_keymap.name;
                    edited(text) => {
                        layout-cursor = -1;
                        layouts.content-y = 0;
                        Lang.filter_keymaps(text);
                    }
                    accepted => {
                        if root.layout-cursor >= 0 && root.layout-cursor < Lang.keymaps.length {
                            select-keymap(Lang.keymaps[root.layout-cursor]);
                        } else if root.first-layout-match {
                            select-keymap(Lang.keymaps[0]);
                        }
                        search-variant.focus();
                    }
                    key-pressed(event) => {
                        if event.text == Key.DownArrow { move-layout-cursor(1); return accept; }
                        if event.text == Key.UpArrow { move-layout-cursor(-1); return accept; }
                        if event.text == Key.PageDown { move-layout-cursor(10); return accept; }
                        if event.text == Key.PageUp { move-layout-cursor(-10); return accept; }
                        reject
                    }
                }

                layouts := ListView {
                    for keymap[i] in Lang.keymaps: TdnListRow {
                        height: row-height;
                        text: keymap.name;
                        secondary: keymap.id;
                        selected: keymap.id == Lang.current_keymap.id;
                        highlighted: i == root.layout-cursor || (i == 0 && root.first-layout-match);
                        clicked => {
                            layout-cursor = i;
                            select-keymap(keymap);
                        }
                    }
                }
            }

            // layouts first, at the start edge
            Separator {
                layout-order: Dir.order(1);
                orientation: vertical;
            }

            VerticalLayout {
                layout-order: Dir.order(2);
                spacing: 0.75rem;
                horizontal-stretch: 1;

                search-variant := TdnInput {
                    placeholder: Lang.t("page-keyboard-search-variant", []);
                    icon: @image-url("../../data/icons/system-search-symbolic.svg");
                    description: root.variant-cursor == 0 ? Lang.t("default", [])
                        : root.variant-cursor > 0 && root.variant-cursor <= Lang.variants.length
                        ? Lang.variants[root.variant-cursor - 1].name
                        : Lang.current_variant.id == "" ? Lang.t("default", []) : Lang.current_variant.name;
                    edited(text) => {
                        variant-cursor = -1;
                        variants.content-y = 0;
                        Lang.filter_variants(text);
                    }
                    accepted => {
                        if root.variant-cursor >= 0 && root.variant-cursor <= Lang.variants.length {
                            select-variant(root.variant-cursor);
                        }
                        root.try-next();
                    }
                    key-pressed(event) => {
                        if event.text == Key.DownArrow { move-variant-cursor(1); return accept; }
                        if event.text == Key.UpArrow { move-variant-cursor(-1); return accept; }
                        if event.text == Key.PageDown { move-variant-cursor(10); return accept; }
                        if event.text == Key.PageUp { move-variant-cursor(-10); return accept; }
                        reject
                    }
                }

                variants := ScrollView {
                    VerticalLayout {
                        alignment: start;

                        TdnListRow {
                            height: row-height;
                            text: Lang.t("default", []);
                            selected: Lang.current_variant.id == "";
                            highlighted: root.variant-cursor == 0;
                            clicked => { select-variant(0); }
                        }

                        for variant[i] in Lang.variants: TdnListRow {
                            height: row-height;
                            text: variant.name;
                            selected: variant.id == Lang.current_variant.id;
                            highlighted: root.variant-cursor == i + 1;
                            clicked => { select-variant(i + 1); }
                        }
                    }
                }
            }
        }
    }

    // only where the distro's input method framework has any
    if Ims.items.length > 0: ImsRow { }
}
