import { Tokens } from "../slintcn/theme/tokens.slint";
import { TdnBasePg, TdnHero } from "../page.slint";
import { Lang, Dir } from "../lang.slint";
import { TdnText, TdnBtn, TdnStyle } from "../components.slint";
import { Cfg } from "../cfg.slint";

export component WelcomePage inherits TdnBasePg {
    // false on the first page, which depends on `skip_pages`
    in property <bool> can-prev: Cfg.prev-page(self.index) != self.index;

    forward-focus: go;

    // a named group around the page, like `TdnPage`'s, so screen readers say which page it is
    VerticalLayout {
        accessible-role: groupbox;
        accessible-label: Lang.t("page-welcome-hello", []);

        TdnHero {
            vertical-stretch: 1;
        }

        HorizontalLayout {
            padding-left: 1.75rem;
            padding-right: 1.75rem;
            padding-top: 1.5rem;
            padding-bottom: 1.5rem;
            spacing: 2rem;

            TdnText {
                text: Lang.t("page-welcome-hello", []);
                font-size: 3 * Tokens.text-rem;
                font-weight: 800;
                horizontal-alignment: Dir.text-start;
                horizontal-stretch: 1;
                wrap: word-wrap;
            }

            // back to the keyboard, so a wrong layout can still be fixed
            if root.can-prev: VerticalLayout {
                layout-order: Dir.order(1);
                alignment: center;
                horizontal-stretch: 0;

                TdnBtn {
                    text: Lang.t("prev", []);
                    clicked => { root.prev_page(); }
                }
            }

            VerticalLayout {
                layout-order: Dir.order(2);
                alignment: center;
                horizontal-stretch: 0;

                go := TdnBtn {
                    enter-hint: true;
                    background-color: TdnStyle.accent;
                    foreground-color: TdnStyle.accent-foreground;
                    text: Cfg.get_string("welcome.next", Lang.t("page-welcome-go", []));
                    clicked => root.next_page();
                }
            }
        }
    }
}
