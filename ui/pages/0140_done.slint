import { Tokens } from "../slintcn/theme/tokens.slint";
import { TdnBasePg, TdnHero } from "../page.slint";
import { Lang, Dir } from "../lang.slint";
import { Install } from "../install.slint";
import { TdnPara, TdnNote, TdnBtn, TdnSpinner } from "../components.slint";

export component DonePage inherits TdnBasePg {
    forward-focus: reboot;

    property <bool> finishing: Install.finishing;
    changed finishing => {
        if !root.finishing && root.active { reboot.focus(); }
    }

    VerticalLayout {
        accessible-role: groupbox;
        accessible-label: Lang.t("page-done", []);

        TdnHero {
            vertical-stretch: 1;
        }

        HorizontalLayout {
            padding-left: 1.75rem;
            padding-right: 1.75rem;
            padding-top: 1.5rem;
            padding-bottom: 1.5rem;
            spacing: 2rem;

            VerticalLayout {
                alignment: center;
                horizontal-stretch: 1;
                spacing: 0.5rem;

                TdnPara {
                    text: Lang.t("page-done", []);
                    font-size: 3 * Tokens.text-rem;
                    font-weight: 800;
                }

                if Install.updates-ready: TdnNote {
                    text: Lang.t(Install.needs-reboot ? "page-done-updates-drivers" : "page-done-updates", []);
                }

                if Install.drivers-failed: TdnNote {
                    text: Lang.t("page-done-drivers-failed", []);
                }

                if Install.locale-failed: TdnNote {
                    text: Lang.t("page-done-locale-failed", []);
                }

                if Install.reboot-failed: TdnNote {
                    text: Lang.t("page-done-reboot-failed", []);
                    color: Tokens.color-destructive;
                }
            }

            VerticalLayout {
                layout-order: Dir.order(1);
                alignment: center;
                horizontal-stretch: 0;

                HorizontalLayout {
                    spacing: 0.75rem;

                    if Install.finishing: VerticalLayout {
                        alignment: center;
                        TdnSpinner {
                            accessible-label: Lang.t("page-done-finishing", []);
                        }
                    }

                    if !Install.needs-reboot && Install.updates-ready: TdnBtn {
                        text: Lang.t("page-done-restart-update", []);
                        enabled: !Install.finishing;
                        clicked => { Install.finish(true); }
                    }

                    if Install.needs-reboot && Install.reboot-failed: TdnBtn {
                        text: Lang.t("page-done-login", []);
                        enabled: !Install.finishing;
                        clicked => { Install.finish(false); }
                    }

                    reboot := TdnBtn {
                        layout-order: Dir.order(1);
                        primary: true;
                        enabled: !Install.finishing;
                        text: Lang.t(
                            !Install.needs-reboot ? "page-done-login"
                            : Install.updates-ready ? "page-done-restart-update"
                            : "page-done-reboot", []);
                        clicked => { Install.finish(Install.needs-reboot); }
                    }
                }
            }
        }
    }
}
