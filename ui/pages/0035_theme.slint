import { TdnPage } from "../page.slint";
import { Lang, Dir } from "../lang.slint";
import { Cfg } from "../cfg.slint";
import { Modal } from "../modal.slint";
import { TdnText, TdnStyle } from "../components.slint";
import { Icon } from "../slintcn/components/icon.slint";
import { LucidePaths } from "../slintcn/components/lucide-paths.slint";
import { Tokens, Theme, ThemeMode } from "../slintcn/theme/tokens.slint";
import { Palette } from "../slintcn/theme/palette.slint";
import { Palette as StdPalette } from "std-widgets.slint";
import { Appearance } from "../appearance.slint";
import { FocusRing } from "../slintcn/components/focus-ring.slint";

component ThemeTile inherits Rectangle {
    in property <string> text;
    in property <bool> dark;
    in property <bool> checked;
    callback picked();
    callback accepted();
    callback switched();

    property <bool> pointer-focus;

    forward-focus: focus;
    accessible-role: radio-button;
    accessible-label: root.text;
    accessible-checkable: true;
    accessible-checked: root.checked;
    accessible-action-default => { if !Modal.open { root.picked(); } }

    border-radius: Tokens.radius-lg;
    border-width: root.checked ? 2px : 1px;
    border-color: root.checked ? TdnStyle.accent : Tokens.color-border-hairline;
    background: Tokens.color-card;
    animate border-color { duration: Tokens.motion-fast; }

    Rectangle {
        border-radius: root.border-radius;
        background: TdnStyle.accent;
        opacity: root.checked ? 0.15 : 0;
        animate opacity { duration: Tokens.motion-fast; }
    }

    Rectangle {
        border-radius: root.border-radius;
        background: Tokens.color-foreground;
        opacity: area.pressed ? 0.1 : area.has-hover ? 0.05 : 0;
        animate opacity { duration: Tokens.motion-fast; easing: ease-out; }
    }

    focus := FocusScope {
        enabled: !Modal.open;
        focus-on-tab-navigation: root.checked;
        key-pressed(event) => {
            root.pointer-focus = false;
            if event.text == " " {
                if !event.repeat { root.picked(); }
                return accept;
            }
            if event.text == Key.Return {
                if !event.repeat {
                    root.picked();
                    root.accepted();
                }
                return accept;
            }
            if event.text == Key.LeftArrow || event.text == Key.RightArrow {
                root.switched();
                return accept;
            }
            reject
        }
    }

    VerticalLayout {
        padding: 0.6rem;
        spacing: 0.6rem;

        Rectangle {
            height: self.width * 9 / 16;
            border-radius: Tokens.radius-md;
            clip: true;

            Image {
                width: 100%;
                height: 100%;
                image-fit: cover;
                source: root.dark ? Cfg.hero-dark-thumb : Cfg.hero-light-thumb;
                accessible-role: none;
            }

            window-mockup := Rectangle {
                x: parent.width * 0.18;
                y: parent.height * 0.22;
                width: parent.width * 0.64;
                height: parent.height * 0.56;
                border-radius: Tokens.radius-sm;
                background: root.dark ? Palette.neutral-900 : Palette.neutral-50;
                drop-shadow-blur: 6 * Tokens.unit;
                drop-shadow-color: #0000004d;
                clip: true;

                Rectangle {
                    y: 0;
                    height: 18%;
                    background: root.dark ? Palette.neutral-800 : Palette.neutral-200;
                }

                for line[i] in [0.7, 0.5, 0.6]: Rectangle {
                    x: parent.width * 0.1;
                    y: parent.height * (0.32 + i * 0.18);
                    width: parent.width * line;
                    height: parent.height * 0.08;
                    border-radius: self.height / 2;
                    background: root.dark ? Palette.neutral-800 : Palette.neutral-200;
                }
            }
        }

        TdnText {
            text: root.text;
            font-size: 1.1 * Tokens.text-rem;
            font-weight: Tokens.typography-weight-medium;
        }
    }

    if root.checked: Rectangle {
        x: Dir.x(parent.width - self.width - 0.4rem, self.width, parent.width);
        y: 0.4rem;
        width: 1.4rem;
        height: self.width;
        border-radius: self.width / 2;
        background: TdnStyle.accent;

        Icon {
            commands: LucidePaths.check;
            size: parent.width * 0.65;
            tint: TdnStyle.accent-foreground;
            stroke-width: 3px;
        }
    }

    area := TouchArea {
        mouse-cursor: pointer;
        pointer-event(ev) => {
            if ev.kind == PointerEventKind.down { root.pointer-focus = true; }
        }
        clicked => {
            root.picked();
            focus.focus();
        }
    }

    if focus.has-focus && !root.pointer-focus: FocusRing {
        host-width: parent.width;
        host-height: parent.height;
        radius: Tokens.radius-lg + self.offset;
    }
}

component AccentRow inherits Rectangle {
    callback accepted();

    property <length> size: 1.75rem;
    property <bool> pointer-focus;
    property <bool> focus-follows-pick;

    function move(delta: int) {
        let step = Lang.rtl ? -delta : delta;
        root.focus-follows-pick = true;
        if Appearance.accent < 0 {
            Appearance.accent = step > 0 ? 0 : Appearance.accents.length - 1;
        } else {
            Appearance.accent = Math.mod(Appearance.accent + step, Appearance.accents.length);
        }
    }

    accessible-role: radio-group;
    accessible-label: Lang.t("page-theme-accent", []);

    HorizontalLayout {
        alignment: center;
        spacing: 0.75rem;

        for accent[i] in Appearance.accents: swatch := Rectangle {
            property <bool> checked: i == Appearance.accent;

            layout-order: Dir.order(i);
            width: root.size;
            height: root.size;
            accessible-role: radio-button;
            accessible-label: Lang.t("page-theme-accent-" + accent.id, []);
            accessible-checkable: true;
            accessible-checked: self.checked;
            accessible-action-default => { if !Modal.open { Appearance.accent = i; } }

            changed checked => {
                if self.checked && root.focus-follows-pick {
                    root.focus-follows-pick = false;
                    focus.focus();
                }
            }

            focus := FocusScope {
                enabled: !Modal.open;
                focus-on-tab-navigation: swatch.checked || (Appearance.accent < 0 && i == 0);
                key-pressed(event) => {
                    root.pointer-focus = false;
                    if event.text == Key.LeftArrow { root.move(-1); return accept; }
                    if event.text == Key.RightArrow { root.move(1); return accept; }
                    if event.text == " " {
                        if !event.repeat { Appearance.accent = i; }
                        return accept;
                    }
                    if event.text == Key.Return {
                        if !event.repeat { root.accepted(); }
                        return accept;
                    }
                    reject
                }
            }

            Rectangle {
                border-radius: self.width / 2;
                background: accent.color;
            }

            if swatch.checked: Icon {
                commands: LucidePaths.check;
                size: root.size * 0.55;
                tint: accent.check;
                stroke-width: 3px;
            }

            TouchArea {
                mouse-cursor: pointer;
                pointer-event(ev) => {
                    if ev.kind == PointerEventKind.down { root.pointer-focus = true; }
                }
                clicked => {
                    Appearance.accent = i;
                    focus.focus();
                }
            }

            if focus.has-focus && !root.pointer-focus: FocusRing {
                host-width: swatch.width;
                host-height: swatch.height;
                radius: swatch.width / 2 + self.offset;
            }
        }
    }
}

export component ThemePage inherits TdnPage {
    pageid: "theme";
    step_i: 0;
    forward-focus: light-tile;

    property <bool> dark: Theme.mode == ThemeMode.dark;

    function pick(dark: bool) {
        StdPalette.color-scheme = dark ? ColorScheme.dark : ColorScheme.light;
    }

    public function focus-picked() {
        if root.dark { dark-tile.focus(); } else { light-tile.focus(); }
    }

    VerticalLayout {
        vertical-stretch: 1;
        alignment: center;
        spacing: 2rem;

        HorizontalLayout {
            alignment: center;
            spacing: 1.5rem;
            accessible-role: radio-group;
            accessible-label: root.name;

            light-tile := ThemeTile {
                width: 12rem;
                text: Lang.t("page-theme-light", []);
                dark: false;
                checked: !root.dark;
                picked => { root.pick(false); }
                accepted => { root.try-next(); }
                switched => {
                    root.pick(true);
                    dark-tile.focus();
                }
            }

            dark-tile := ThemeTile {
                layout-order: Dir.order(1);
                width: 12rem;
                text: Lang.t("page-theme-dark", []);
                dark: true;
                checked: root.dark;
                picked => { root.pick(true); }
                accepted => { root.try-next(); }
                switched => {
                    root.pick(false);
                    light-tile.focus();
                }
            }
        }

        if Appearance.accents.length > 0: VerticalLayout {
            spacing: 0.75rem;

            TdnText {
                text: Lang.t("page-theme-accent", []);
                horizontal-alignment: center;
                font-weight: Tokens.typography-weight-medium;
                accessible-role: none;
            }

            AccentRow {
                accepted => { root.try-next(); }
            }
        }
    }
}
