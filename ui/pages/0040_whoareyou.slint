import { TdnPage } from "../page.slint";
import { Lang, Dir } from "../lang.slint";
import { Account, Avatar } from "../account.slint";
import { Camera } from "../camera.slint";
import { TdnInput, TdnField, TdnText, TdnStyle, TdnBtn, TdnSpinner, TdnDialog, Modal, DialogOpener } from "../components.slint";
import { FocusRing } from "../slintcn/components/focus-ring.slint";
import { Tokens } from "../slintcn/theme/tokens.slint";

export component UserIcon inherits Rectangle {
    width: 3rem;
    height: self.width;
    border-radius: self.width / 2;
    clip: true;
    background: Account.avatar-id == "" ? TdnStyle.accent : transparent;
    accessible-role: image;
    accessible-label: Lang.t("page-whoareyou-icon", []);

    if Account.avatar-id != "": Image {
        width: 100%;
        height: 100%;
        image-fit: cover;
        source: Account.avatar;
    }

    if Account.avatar-id == "": Image {
        source: @image-url("../../data/icons/system-users-symbolic.svg");
        colorize: TdnStyle.accent-foreground;
        width: 55%;
    }
}

component IconButton inherits Rectangle {
    in property <image> image;
    in property <string> label;
    in property <bool> selected;
    in property <bool> enabled: true;
    in property <bool> symbolic;
    callback clicked;

    property <bool> pointer-focus;

    function press() {
        root.clicked();
        opener.opened();
    }

    forward-focus: focus;
    accessible-role: button;
    accessible-label: root.label;
    accessible-enabled: root.enabled;
    accessible-checkable: !root.symbolic;
    accessible-checked: root.selected;
    accessible-action-default => {
        if root.enabled && !Modal.open { root.press(); }
    }

    width: 3.1rem;
    height: self.width;
    border-radius: self.width / 2;
    border-width: 2px;
    border-color: root.selected ? TdnStyle.accent : transparent;
    opacity: root.enabled ? 1 : 0.4;

    Rectangle {
        width: parent.width - 0.4rem;
        height: self.width;
        border-radius: self.width / 2;
        clip: true;
        background: root.symbolic ? Tokens.color-primary : transparent;

        if !root.symbolic: Image {
            width: 100%;
            height: 100%;
            image-fit: cover;
            source: root.image;
        }

        if root.symbolic: Image {
            source: root.image;
            colorize: Tokens.color-primary-foreground;
            width: 45%;
        }

        if area.has-hover && root.enabled: Rectangle {
            border-radius: self.width / 2;
            background: #ffffff30;
        }
    }

    focus := FocusScope {
        enabled: root.enabled && !Modal.open;
        key-pressed(event) => {
            root.pointer-focus = false;
            if event.text == " " || event.text == Key.Return {
                if !event.repeat { root.press(); }
                return accept;
            }
            reject
        }
    }

    opener := DialogOpener {
        restore => { focus.focus(); }
    }

    area := TouchArea {
        enabled: root.enabled;
        mouse-cursor: pointer;
        pointer-event(ev) => {
            if ev.kind == PointerEventKind.down { root.pointer-focus = true; }
        }
        clicked => { root.press(); }
    }

    if focus.has-focus && !root.pointer-focus: FocusRing {
        host-width: parent.width;
        host-height: parent.height;
        radius: parent.width / 2 + self.offset;
    }
}

component Slot inherits IconButton {
    in property <int> index;
    property <bool> camera: root.index < 0;
    property <Avatar> avatar: Account.avatars[root.index];
    symbolic: root.camera;
    image: root.camera ? @image-url("../../data/icons/camera-photo-symbolic.svg") : root.avatar.image;
    selected: !root.camera && Account.avatar-id == root.avatar.id;
    label: root.camera ? Lang.t("page-whoareyou-camera", []) : Lang.t("page-whoareyou-icon-n", [{ key: "n", value: root.index + 1 }]);
    enabled: !root.camera || Camera.available;
    clicked => {
        if root.camera {
            Camera.start();
        } else {
            Account.avatar-id = root.avatar.id;
            Account.avatar = root.avatar.image;
        }
    }
}

component IconPicker inherits VerticalLayout {
    spacing: 1.25rem;
    alignment: start;

    property <bool> account-preview-ready: Account.avatar-id != "" && Account.username != "" && Account.username-error == "";

    HorizontalLayout {
        spacing: 0.75rem;

        UserIcon { }

        if root.account-preview-ready: VerticalLayout {
            layout-order: Dir.order(1);
            alignment: center;

            TdnText {
                text: Account.fullname != "" ? Account.fullname : Account.username;
                font-weight: Tokens.typography-weight-medium;
                horizontal-alignment: Dir.text-start;
                overflow: elide;
            }

            if Account.fullname != "": TdnText {
                text: Account.username;
                color: Tokens.color-muted-foreground;
                font-size: Tokens.typography-body-sm-size;
                horizontal-alignment: Dir.text-start;
                overflow: elide;
            }
        }

        if !root.account-preview-ready: VerticalLayout {
            layout-order: Dir.order(1);
            alignment: center;

            TdnText {
                text: Lang.t("page-whoareyou-icon", []);
                font-weight: Tokens.typography-weight-medium;
                horizontal-alignment: Dir.text-start;
            }

            TdnText {
                text: Lang.t("page-whoareyou-icon-desc", []);
                color: Tokens.color-muted-foreground;
                font-size: Tokens.typography-body-sm-size;
                horizontal-alignment: Dir.text-start;
                wrap: word-wrap;
            }
        }
    }

    VerticalLayout {
        spacing: 0.15rem;

        for row in Account.avatar-rows: HorizontalLayout {
            alignment: center;
            spacing: 0.4rem;

            for slot in row.slots: Slot { index: slot; }
        }
    }
}

export component CameraDialog inherits TdnDialog {
    title: Lang.t("page-whoareyou-camera", []);
    dismissed => { Camera.stop(); }
    init => { cancel.focus(); }

    property <bool> can-take: Camera.error == "" && Camera.frame.width > 0;
    changed can-take => {
        if self.can-take && cancel.has-focus { take.focus(); }
    }

    HorizontalLayout {
        alignment: center;

        Rectangle {
            width: 14rem;
            height: self.width;
            border-radius: self.width / 2;
            clip: true;
            background: Camera.frame.width > 0 ? transparent : Tokens.color-card;

            Image {
                width: 100%;
                height: 100%;
                image-fit: cover;
                source: Camera.frame;
                accessible-role: none;
            }

            if Camera.error == "" && Camera.frame.width == 0: TdnSpinner { }

            if Camera.error != "": TdnText {
                width: parent.width - 2rem;
                text: Lang.t("page-whoareyou-camera-error", []) + "\n" + Camera.error;
                color: Tokens.color-destructive;
                wrap: word-wrap;
            }
        }
    }

    HorizontalLayout {
        alignment: space-between;

        cancel := TdnBtn {
            in-dialog: true;
            text: Lang.t("cancel", []);
            clicked => { Camera.stop(); }
        }

        take := TdnBtn {
            layout-order: Dir.order(1);
            in-dialog: true;
            text: Lang.t("page-whoareyou-camera-take", []);
            enter-hint: true;
            enabled: root.can-take;
            background-color: TdnStyle.accent;
            foreground-color: TdnStyle.accent-foreground;
            clicked => { Camera.capture(); }
        }
    }
}

export component WhoAreYouPage inherits TdnPage {
    pageid: "whoareyou";
    step_i: 0;
    can-next: Account.username-valid && Account.fullname-valid;
    forward-focus: nameinput;

    property <bool> next-after-username-check;
    property <string> checked-for: Account.checked-username;
    changed checked-for => {
        if self.next-after-username-check && self.active {
            self.next-after-username-check = false;
            if !Modal.open { self.try-next(); }
        }
    }
    changed active => {
        if self.active {
            Camera.refresh();
        } else {
            self.next-after-username-check = false;
        }
    }

    HorizontalLayout {
        spacing: 1rem;

        VerticalLayout {
            alignment: start;
            horizontal-stretch: 100;
            max-width: 23rem;
            padding-top: 1rem;
            spacing: 2rem;

            name-field := TdnField {
                label: Lang.t("page-whoareyou-fullname", []);
                help: Lang.t("page-whoareyou-fullname-desc", []);
                error: Account.fullname-valid ? "" : Lang.t("page-whoareyou-error-fullname", []);
                label-clicked => { nameinput.focus(); }

                nameinput := TdnInput {
                    label: name-field.label;
                    description: name-field.description;
                    text <=> Account.fullname;
                    invalid: !Account.fullname-valid;
                    edited(text) => {
                        root.next-after-username-check = false;
                        if !Account.username-touched {
                            Account.username = Account.suggest-username(text, Account.username);
                        }
                    }
                    accepted => {
                        userinput.focus();
                        userinput.select-all();
                    }
                }
            }

            username-field := TdnField {
                property <bool> invalid: Account.username != "" && Account.username-error != "";
                label: Lang.t("page-whoareyou-username", []);
                help: Lang.t("page-whoareyou-username-desc", []);
                error: self.invalid ? Lang.t(Account.username-error, []) : "";
                label-clicked => { userinput.focus(); }

                userinput := TdnInput {
                    label: username-field.label;
                    description: username-field.description;
                    text <=> Account.username;
                    invalid: username-field.invalid;
                    edited(text) => {
                        Account.username-touched = text != "";
                        root.next-after-username-check = false;
                    }
                    accepted => {
                        root.next-after-username-check = !root.can-next && Account.username-error == ""
                            && Account.checked-username != Account.username;
                        root.try-next();
                    }
                }
            }
        }

        Rectangle {
            layout-order: Dir.order(1);
            horizontal-stretch: 1;
        }

        IconPicker {
            layout-order: Dir.order(2);
            horizontal-stretch: 0;
            width: 13.5rem;
        }
    }
}
