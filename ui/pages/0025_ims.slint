import { Lang, Dir } from "../lang.slint";
import { Ims } from "../ims.slint";
import { TdnText, TdnBtn, TdnToggleRow, TdnDialog, TdnStyle, TdnScrollList } from "../components.slint";
import { Tokens } from "../slintcn/theme/tokens.slint";

export component ImsDialog inherits TdnDialog {
    title: Lang.t("page-keyboard-ims", []);
    dialog-width: 26rem;
    dismissed => { Ims.open = false; }

    TdnText {
        text: Lang.t("page-keyboard-ims-desc", []);
        color: Tokens.color-muted-foreground;
        horizontal-alignment: Dir.text-start;
        wrap: word-wrap;
    }

    scroll := TdnScrollList {
        spacing: 0.5rem;

        for im[i] in Ims.items: VerticalLayout {
            spacing: 0.5rem;

            if i == 0 || Ims.items[i - 1].lang != im.lang: TdnText {
                text: im.lang;
                font-weight: Tokens.typography-weight-medium;
                color: Tokens.color-muted-foreground;
                horizontal-alignment: Dir.text-start;
            }

            TdnToggleRow {
                in-dialog: true;
                text: im.native == im.name ? im.name : im.name + " (" + im.native + ")";
                checked: im.on;
                toggled(on) => { Ims.set(i, on); }
                focus-in(y, height) => { scroll.reveal(y, height); }
                accepted => { root.dismissed(); }
            }
        }
    }

    HorizontalLayout {
        alignment: Dir.end;

        done := TdnBtn {
            in-dialog: true;
            text: Lang.t("done", []);
            enter-hint: true;
            background-color: TdnStyle.accent;
            foreground-color: TdnStyle.accent-foreground;
            clicked => { root.dismissed(); }
        }
    }

    init => { done.focus(); }
}
