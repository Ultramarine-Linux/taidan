import { Lang, Dir } from "../lang.slint";
import { Ims } from "../ims.slint";
import { TdnText, TdnBtn, TdnToggleRow, TdnDialog, TdnStyle } from "../components.slint";
import { Tokens } from "../slintcn/theme/tokens.slint";
import { ScrollView } from "std-widgets.slint";

// input methods to add, opened from the keyboard page
export component ImsDialog inherits TdnDialog {
    title: Lang.t("page-keyboard-ims", []);
    dialog-width: 26rem;
    dismissed => { Ims.open = false; }

    TdnText {
        text: Lang.t("page-keyboard-ims-desc", []);
        color: Tokens.color-muted-foreground;
        horizontal-alignment: Dir.text-start;
        wrap: word-wrap;
    }

    scroll := ScrollView {
        // as tall as the list, the dialog shrinks it to fit the window and it scrolls
        preferred-height: list-end.y;
        content-width: self.visible-width;
        content-height: list-end.y;
        horizontal-scrollbar-policy: always-off;

        list := VerticalLayout {
            width: scroll.visible-width;
            height: self.preferred-height;
            alignment: start;
            spacing: 0.5rem;
            // room for the focus rings and the scrollbar
            padding-left: Tokens.focus-ring-offset + Tokens.focus-ring-width;
            padding-top: self.padding-left;
            padding-right: 0.9rem;

            for im[i] in Ims.items: VerticalLayout {
                spacing: 0.5rem;

                // a heading where the language changes
                if i == 0 || Ims.items[i - 1].lang != im.lang: TdnText {
                    text: im.lang;
                    font-weight: Tokens.typography-weight-medium;
                    color: Tokens.color-muted-foreground;
                    horizontal-alignment: Dir.text-start;
                }

                TdnToggleRow {
                    in-dialog: true;
                    text: im.native == im.name ? im.name : im.name + " (" + im.native + ")";
                    checked: im.on;
                    toggled(on) => { Ims.set(i, on); }
                    // Enter closes it like Done, Space toggles
                    accepted => { root.dismissed(); }
                }
            }

            list-end := Rectangle { height: 0; }
        }
    }

    HorizontalLayout {
        alignment: Dir.end;

        done := TdnBtn {
            in-dialog: true;
            text: Lang.t("done", []);
            enter-hint: true;
            background-color: TdnStyle.accent;
            foreground-color: TdnStyle.accent-foreground;
            clicked => { root.dismissed(); }
        }
    }

    init => { done.focus(); }
}
