import { TdnPage } from "../page.slint";
import { Lang } from "../lang.slint";
import { Account } from "../account.slint";
import { TdnInput, TdnField, TdnText } from "../components.slint";
import { Card } from "../slintcn/components/card.slint";
import { Icon } from "../slintcn/components/icon.slint";
import { LucidePaths } from "../slintcn/components/lucide-paths.slint";
import { Tokens } from "../slintcn/theme/tokens.slint";

// an example password in the tips card, marked good or bad
component PasswordExample inherits VerticalLayout {
    in property <bool> good;
    in property <string> example;
    in property <string> description;

    spacing: 0.25rem;

    HorizontalLayout {
        spacing: 0.5rem;

        Rectangle {
            width: 1.25rem;
            height: self.width;
            border-radius: self.width / 2;
            background: root.good ? Tokens.color-affirm : Tokens.color-destructive;

            Icon {
                commands: root.good ? LucidePaths.check : LucidePaths.x-mark;
                size: parent.width * 0.7;
                tint: white;
                stroke-width: 3px;
            }
        }

        TdnText {
            text: root.example;
            font-weight: Tokens.typography-weight-medium;
            horizontal-alignment: left;
        }
    }

    TdnText {
        text: root.description;
        font-size: Tokens.typography-label-size;
        horizontal-alignment: left;
        wrap: word-wrap;
    }
}

export component PasswordPage inherits TdnPage {
    pageid: "password";
    step_i: 0;
    can-next: Account.password-valid;
    forward-focus: passwdinput;

    HorizontalLayout {
        spacing: 1rem;

        VerticalLayout {
            alignment: start;
            // grows to its max width before the spacer takes the rest
            horizontal-stretch: 100;
            max-width: 23rem;
            padding-top: 1rem;
            spacing: 2rem;

            TdnField {
                label: Lang.t("page-password-pw", []);
                label-clicked => { passwdinput.focus(); }

                passwdinput := TdnInput {
                    text <=> Account.password;
                    password: true;
                    reveal-label: Lang.t("page-password-show", []);
                    accepted => { repeatinput.focus(); }
                }
            }

            repeat-field := TdnField {
                property <bool> mismatch: Account.password-repeat != "" && Account.password-repeat != Account.password;
                label: Lang.t("page-password-rp", []);
                error: self.mismatch ? Lang.t("page-password-mismatch", []) : "";
                label-clicked => { repeatinput.focus(); }

                repeatinput := TdnInput {
                    text <=> Account.password-repeat;
                    password: true;
                    invalid: repeat-field.mismatch;
                    reveal-label: Lang.t("page-password-show", []);
                    accepted => { root.try-next(); }
                }
            }
        }

        // pushes the tips card to the right edge on wider windows
        Rectangle {
            horizontal-stretch: 1;
        }

        VerticalLayout {
            alignment: start;
            horizontal-stretch: 0;
            width: 13.5rem;

            Card {
                card-radius: md;

                VerticalLayout {
                    padding: 0.6rem;
                    spacing: 0.75rem;

                    VerticalLayout {
                        spacing: 0.25rem;

                        TdnText {
                            text: Lang.t("page-password-tip-title", []);
                            font-size: Tokens.typography-title-size;
                            font-weight: Tokens.typography-weight-medium;
                            horizontal-alignment: left;
                            wrap: word-wrap;
                        }

                        TdnText {
                            text: Lang.t("page-password-tip", []);
                            horizontal-alignment: left;
                            wrap: word-wrap;
                        }
                    }

                    PasswordExample {
                        good: true;
                        example: Lang.t("page-password-tip-good", []);
                        description: Lang.t("page-password-tip-good-desc", []);
                    }

                    PasswordExample {
                        good: false;
                        example: Lang.t("page-password-tip-bad", []);
                        description: Lang.t("page-password-tip-bad-desc", []);
                    }
                }
            }
        }
    }
}
