import { TdnPage } from "../page.slint";
import { Lang, Dir } from "../lang.slint";
import { Account } from "../account.slint";
import { TdnTextField, TdnText, TdnPara, TdnFormColumn, TdnSideCard } from "../components.slint";
import { Icon } from "../slintcn/components/icon.slint";
import { LucidePaths } from "../slintcn/components/lucide-paths.slint";
import { Tokens } from "../slintcn/theme/tokens.slint";

component PasswordExample inherits VerticalLayout {
    in property <bool> good;
    in property <string> example;
    in property <string> description;

    spacing: 0.25rem;

    HorizontalLayout {
        spacing: 0.5rem;

        Rectangle {
            width: 1.25rem;
            height: self.width;
            border-radius: self.width / 2;
            background: root.good ? Tokens.color-affirm : Tokens.color-destructive-solid;

            Icon {
                commands: root.good ? LucidePaths.check : LucidePaths.x-mark;
                size: parent.width * 0.7;
                tint: white;
                stroke-width: 3px;
            }
        }

        TdnText {
            layout-order: Dir.order(1);
            text: root.example;
            font-weight: Tokens.typography-weight-medium;
            horizontal-alignment: Dir.text-start;
        }
    }

    TdnPara {
        text: root.description;
        font-size: Tokens.typography-label-size;
    }
}

export component PasswordPage inherits TdnPage {
    pageid: "password";
    step_i: 0;
    can-next: Account.password-valid;
    forward-focus: passwdinput;

    HorizontalLayout {
        spacing: 1rem;

        TdnFormColumn {
            passwdinput := TdnTextField {
                label: Lang.t("page-password-pw", []);
                error: Account.password-too-long ? Lang.t("page-password-long", []) : "";
                text <=> Account.password;
                password: true;
                page-active: root.active;
                accepted => { repeatinput.focus(); }
            }

            repeatinput := TdnTextField {
                label: Lang.t("page-password-rp", []);
                error: Account.password-repeat != "" && Account.password-repeat != Account.password
                    ? Lang.t("page-password-mismatch", []) : "";
                text <=> Account.password-repeat;
                password: true;
                page-active: root.active;
                accepted => { root.try-next(); }
            }
        }

        TdnSideCard {
            width: 13.5rem;

            VerticalLayout {
                spacing: 0.25rem;

                TdnPara {
                    text: Lang.t("page-password-tip-title", []);
                    font-size: Tokens.typography-title-size;
                    font-weight: Tokens.typography-weight-medium;
                }

                TdnPara {
                    text: Lang.t("page-password-tip", []);
                }
            }

            PasswordExample {
                good: true;
                example: Lang.t("page-password-tip-good", []);
                description: Lang.t("page-password-tip-good-desc", []);
            }

            PasswordExample {
                good: false;
                example: Lang.t("page-password-tip-bad", []);
                description: Lang.t("page-password-tip-bad-desc", []);
            }
        }
    }
}
