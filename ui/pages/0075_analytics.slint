import { TdnPage } from "../page.slint";
import { Lang, Dir, FluentArg } from "../lang.slint";
import { Cfg } from "../cfg.slint";
import { Analytics, AnalyticsDevice } from "../analytics.slint";
import { TdnText, TdnPara, TdnBtn, TdnDialog, TdnToggleRow, TdnFormColumn, TdnSideCard } from "../components.slint";
import { Icon } from "../slintcn/components/icon.slint";
import { Card } from "../slintcn/components/card.slint";
import { Separator } from "../slintcn/components/separator.slint";
import { Tokens } from "../slintcn/theme/tokens.slint";

export component AnalyticsPage inherits TdnPage {
    pageid: "analytics";
    step_i: 1;
    forward-focus: toggle;
    can-next: Analytics.chosen;

    property <[FluentArg]> args: [
        { key: "org", value: Cfg.get_string("org", "Fyra Labs") },
        { key: "distro", value: Cfg.distro },
    ];

    HorizontalLayout {
        spacing: 1rem;

        TdnFormColumn {
            column-width: 21rem;

            VerticalLayout {
                spacing: 0.75rem;

                TdnPara {
                    text: Lang.t("page-analytics-desc", root.args);
                    font-size: 1.1 * Tokens.text-rem;
                }

                TdnPara {
                    text: Lang.t("page-analytics-desc2", []);
                    font-size: 1.1 * Tokens.text-rem;
                }
            }

            VerticalLayout {
                spacing: 0.75rem;

                toggle := TdnToggleRow {
                    text: Lang.t("page-analytics-switch", []);
                    checked: Analytics.enabled;
                    undecided: !Analytics.chosen;
                    toggled(on) => {
                        Analytics.enabled = on;
                        Analytics.chosen = true;
                    }
                    accepted => { root.try-next(); }
                }

                HorizontalLayout {
                    alignment: Dir.start;

                    TdnBtn {
                        outline: true;
                        enabled: Analytics.sample-ready;
                        text: Lang.t("page-analytics-sample", []);
                        icon: @image-url("../../data/icons/clipboard-symbolic.svg");
                        icon-size: 1rem;
                        clicked => { Analytics.sample-open = true; }
                    }
                }
            }
        }

        TdnSideCard {
            width: 12.5rem;
            content-spacing: 0.5rem;

            HorizontalLayout {
                spacing: 0.5rem;

                Icon {
                    // "hat-glasses" from Lucide (https://lucide.dev), ISC license
                    commands: "M14 18a2 2 0 0 0-4 0 M19 11l-2.11-6.657a2 2 0 0 0-2.752-1.148l-1.276.61A2 2 0 0 1 12 4H8.5a2 2 0 0 0-1.925 1.456L5 11 M2 11h20 M14 18a3 3 0 1 0 6 0a3 3 0 1 0-6 0 M4 18a3 3 0 1 0 6 0a3 3 0 1 0-6 0";
                    size: 1.4rem;
                    stroke-width: 1.75px;
                }

                TdnPara {
                    layout-order: Dir.order(1);
                    text: Lang.t("page-analytics-tip-title", []);
                    font-size: Tokens.typography-title-size;
                    font-weight: Tokens.typography-weight-medium;
                }
            }

            TdnPara {
                text: Lang.t("page-analytics-tip", root.args);
            }

            TdnPara {
                text: Lang.t("page-analytics-tip-once", []);
            }
        }
    }
}

component SampleRow inherits HorizontalLayout {
    in property <string> label;
    in property <string> value;

    padding-top: 0.6rem;
    padding-bottom: 0.6rem;
    spacing: 1rem;

    TdnText {
        text: root.label;
        color: Tokens.color-muted-foreground;
        horizontal-alignment: Dir.text-start;
    }

    TdnText {
        layout-order: Dir.order(1);
        text: root.value != "" ? root.value : Lang.t("page-analytics-unknown", []);
        font-weight: Tokens.typography-weight-medium;
        horizontal-alignment: Dir.text-end;
        horizontal-stretch: 1;
        overflow: elide;
    }
}

export component AnalyticsSampleDialog inherits TdnDialog {
    title: Lang.t("page-analytics-sample", []);
    done-text: Lang.t("done", []);
    dialog-width: 24rem;
    dismissed => { Analytics.sample-open = false; }

    property <string> device-id: Analytics.sample.device == AnalyticsDevice.chromebook ? "page-analytics-device-chromebook"
        : Analytics.sample.device == AnalyticsDevice.surface ? "page-analytics-device-surface"
        : Analytics.sample.device == AnalyticsDevice.raspberry-pi ? "page-analytics-device-raspberry-pi"
        : "page-analytics-device-other";

    Card {
        card-radius: md;

        VerticalLayout {
            padding-left: 0.85rem;
            padding-right: 0.85rem;
            padding-top: 0.15rem;
            padding-bottom: 0.15rem;

            SampleRow {
                label: Lang.t("page-analytics-field-version", []);
                value: Analytics.sample.version;
            }

            Separator { }

            SampleRow {
                label: Lang.t("page-analytics-field-edition", []);
                value: Analytics.sample.edition;
            }

            Separator { }

            SampleRow {
                label: Lang.t("page-analytics-field-arch", []);
                value: Analytics.sample.arch;
            }

            Separator { }

            SampleRow {
                label: Lang.t("page-analytics-field-device", []);
                value: Lang.t(root.device-id, []);
            }
        }
    }
}
