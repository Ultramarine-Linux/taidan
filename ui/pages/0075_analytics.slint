import { TdnPage } from "../page.slint";
import { Lang, Dir, FluentArg } from "../lang.slint";
import { Cfg } from "../cfg.slint";
import { Analytics } from "../analytics.slint";
import { TdnPara, TdnBtn, TdnDialog, TdnToggleRow, TdnFormColumn, TdnSideCard } from "../components.slint";
import { Icon } from "../slintcn/components/icon.slint";
import { ScrollView } from "std-widgets.slint";
import { Tokens } from "../slintcn/theme/tokens.slint";

export component AnalyticsPage inherits TdnPage {
    pageid: "analytics";
    step_i: 1;
    forward-focus: toggle;

    property <[FluentArg]> args: [
        { key: "org", value: Cfg.get_string("org", "Fyra Labs") },
        { key: "distro", value: Cfg.distro },
    ];

    HorizontalLayout {
        spacing: 1rem;

        TdnFormColumn {
            column-width: 21rem;

            VerticalLayout {
                spacing: 0.75rem;

                TdnPara {
                    text: Lang.t("page-analytics-desc", root.args);
                    font-size: 1.1 * Tokens.text-rem;
                }

                TdnPara {
                    text: Lang.t("page-analytics-desc2", []);
                    font-size: 1.1 * Tokens.text-rem;
                }
            }

            VerticalLayout {
                spacing: 0.75rem;

                toggle := TdnToggleRow {
                    text: Lang.t("page-analytics-switch", []);
                    checked: Analytics.enabled;
                    toggled(on) => { Analytics.enabled = on; }
                    accepted => { root.try-next(); }
                }

                HorizontalLayout {
                    alignment: Dir.start;

                    TdnBtn {
                        outline: true;
                        enabled: Analytics.sample != "";
                        text: Lang.t("page-analytics-sample", []);
                        icon: @image-url("../../data/icons/clipboard-symbolic.svg");
                        icon-size: 1rem;
                        clicked => { Analytics.sample-open = true; }
                    }
                }
            }
        }

        TdnSideCard {
            width: 12.5rem;
            content-spacing: 0.5rem;

            HorizontalLayout {
                spacing: 0.5rem;

                Icon {
                    // "hat-glasses" from Lucide (https://lucide.dev), ISC license
                    commands: "M14 18a2 2 0 0 0-4 0 M19 11l-2.11-6.657a2 2 0 0 0-2.752-1.148l-1.276.61A2 2 0 0 1 12 4H8.5a2 2 0 0 0-1.925 1.456L5 11 M2 11h20 M14 18a3 3 0 1 0 6 0a3 3 0 1 0-6 0 M4 18a3 3 0 1 0 6 0a3 3 0 1 0-6 0";
                    size: 1.4rem;
                    stroke-width: 1.75px;
                }

                TdnPara {
                    layout-order: Dir.order(1);
                    text: Lang.t("page-analytics-tip-title", []);
                    font-size: Tokens.typography-title-size;
                    font-weight: Tokens.typography-weight-medium;
                }
            }

            TdnPara {
                text: Lang.t("page-analytics-tip", root.args);
            }

            TdnPara {
                text: Lang.t("page-analytics-tip-once", []);
            }
        }
    }
}

export component AnalyticsSampleDialog inherits TdnDialog {
    title: Lang.t("page-analytics-sample", []);
    description: Lang.t("page-analytics-sample-desc", []);
    done-text: Lang.t("done", []);
    dialog-width: 26rem;
    dismissed => { Analytics.sample-open = false; }

    Rectangle {
        border-radius: Tokens.radius-md;
        border-width: 1px;
        border-color: Tokens.color-border-hairline;
        background: Tokens.color-card;
        height: min(sample.preferred-height + 1.5rem, 14rem);

        ScrollView {
            sample := TextInput {
                x: 0.75rem;
                y: 0.75rem;
                width: parent.width - 1.5rem;
                read-only: true;
                single-line: false;
                wrap: word-wrap;
                text: Analytics.sample;
                font-family: "monospace";
                accessible-label: Lang.t("page-analytics-sample", []);
                font-size: Tokens.typography-body-sm-size;
                color: Tokens.color-foreground;
            }
        }
    }
}
