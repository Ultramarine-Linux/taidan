import { TdnPage } from "../page.slint";
import { Lang } from "../lang.slint";
import { ListView } from "std-widgets.slint";
import { TdnInput, TdnListRow } from "../components.slint";
import { Card } from "../slintcn/components/card.slint";

export component LanguagePage inherits TdnPage {
    pageid: "language";
    show-steps: false;
    can-prev: false;
    forward-focus: search;

    property <length> row-height: 2.25rem;
    property <int> arrow-key-row: -1;
    property <int> current-language-row: -1;
    property <bool> enter-picks-first-match: search.text != "" && arrow-key-row < 0
        && current-language-row < 0 && Lang.languages.length > 0;

    function start-arrow-keys-at-current-language() {
        if arrow-key-row < 0 && current-language-row >= 0
            && current-language-row < Lang.languages.length
            && Lang.languages[current-language-row].locale == Lang.current_language.locale {
            arrow-key-row = current-language-row;
        }
    }

    function scroll-to-arrow-key-row() {
        let top = arrow-key-row * row-height;
        if top < -list.content-y {
            list.content-y = -top;
        } else if top + row-height > -list.content-y + list.visible-height {
            list.content-y = list.visible-height - top - row-height;
        }
    }

    function move-arrow-key-row(delta: int) {
        if Lang.languages.length == 0 { return; }
        start-arrow-keys-at-current-language();
        arrow-key-row = max(0, min(Lang.languages.length - 1, arrow-key-row + delta));
        Lang.select(Lang.languages[arrow-key-row]);
        scroll-to-arrow-key-row();
    }

    Card {
        vertical-stretch: 1;

        // `ListView` only creates the rows in view, so this finds the current one
        for lang[i] in Lang.languages: Rectangle {
            property <bool> current: lang.locale == Lang.current_language.locale;
            width: 0;
            height: 0;
            init => { if self.current { root.current-language-row = i; } }
            changed current => {
                if self.current { root.current-language-row = i; }
                else if root.current-language-row == i { root.current-language-row = -1; }
            }
        }

        VerticalLayout {
            padding: 1rem;
            spacing: 0.75rem;

            search := TdnInput {
                placeholder: Lang.t("page-language-search-lang", []);
                icon: @image-url("../../data/icons/system-search-symbolic.svg");
                description: root.enter-picks-first-match ? Lang.name(Lang.languages[0]) : Lang.name(Lang.current_language);
                edited(text) => {
                    arrow-key-row = -1;
                    // filtering drops rows without running their `changed current`
                    root.current-language-row = -1;
                    list.content-y = 0;
                    Lang.filter_languages(text);
                }
                accepted => {
                    if root.enter-picks-first-match { Lang.select(Lang.languages[0]); }
                    root.try-next();
                }
                key-pressed(event) => {
                    if event.text == Key.DownArrow { move-arrow-key-row(1); return accept; }
                    if event.text == Key.UpArrow { move-arrow-key-row(-1); return accept; }
                    if event.text == Key.PageDown { move-arrow-key-row(10); return accept; }
                    if event.text == Key.PageUp { move-arrow-key-row(-10); return accept; }
                    reject
                }
            }

            list := ListView {
                for lang[i] in Lang.languages: TdnListRow {
                    height: row-height;
                    text: Lang.name(lang);
                    secondary: lang.native-name;
                    selected: lang.locale == Lang.current_language.locale;
                    highlighted: i == 0 && root.enter-picks-first-match;
                    clicked => {
                        arrow-key-row = i;
                        Lang.select(lang);
                    }
                }
            }
        }
    }
}
