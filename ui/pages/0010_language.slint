import { TdnPage } from "../page.slint";
import { Lang } from "../lang.slint";
import { ListView } from "std-widgets.slint";
import { TdnInput, TdnListRow } from "../components.slint";
import { Card } from "../slintcn/components/card.slint";

export component LanguagePage inherits TdnPage {
    pageid: "language";
    show-steps: false;
    can-prev: false;
    forward-focus: search;

    property <length> row-height: 2.25rem;
    // row moved to with the arrow keys, -1 until the user does so
    property <int> cursor: -1;
    // row of the current language in the list, -1 if it's filtered out, see the finder below
    property <int> current-row: -1;

    function move-cursor(delta: int) {
        if Lang.languages.length == 0 { return; }
        // start from the current language, so the first press moves away from it instead of
        // jumping to the top of the list and switching to that
        if cursor < 0 && current-row >= 0 && current-row < Lang.languages.length
            && Lang.languages[current-row].locale == Lang.current_language.locale {
            cursor = current-row;
        }
        cursor = max(0, min(Lang.languages.length - 1, cursor + delta));
        Lang.select(Lang.languages[cursor]);
        // keep the row in view
        let top = cursor * row-height;
        if top < -list.content-y {
            list.content-y = -top;
        } else if top + row-height > -list.content-y + list.visible-height {
            list.content-y = list.visible-height - top - row-height;
        }
    }

    Card {
        variant: solid;
        vertical-stretch: 1;

        // finds the current language's row, which `ListView` can't tell as it only creates the
        // rows in view
        for lang[i] in Lang.languages: Rectangle {
            property <bool> current: lang.locale == Lang.current_language.locale;
            width: 0;
            height: 0;
            init => { if self.current { root.current-row = i; } }
            changed current => {
                if self.current { root.current-row = i; }
                else if root.current-row == i { root.current-row = -1; }
            }
        }

        VerticalLayout {
            padding: 1rem;
            spacing: 0.75rem;

            search := TdnInput {
                placeholder: Lang.t("page-language-search-lang", []);
                icon: @image-url("../../data/icons/system-search-symbolic.svg");
                edited(text) => {
                    cursor = -1;
                    list.content-y = 0;
                    Lang.filter_languages(text);
                }
                accepted => { root.try-next(); }
                key-pressed(event) => {
                    if event.text == Key.DownArrow { move-cursor(1); return accept; }
                    if event.text == Key.UpArrow { move-cursor(-1); return accept; }
                    if event.text == Key.PageDown { move-cursor(10); return accept; }
                    if event.text == Key.PageUp { move-cursor(-10); return accept; }
                    reject
                }
            }

            list := ListView {
                for lang[i] in Lang.languages: TdnListRow {
                    height: row-height;
                    text: Lang.name(lang);
                    secondary: lang.native-name;
                    selected: lang.locale == Lang.current_language.locale;
                    clicked => {
                        cursor = i;
                        Lang.select(lang);
                    }
                }
            }
        }
    }
}
