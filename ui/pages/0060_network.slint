import { TdnPage } from "../page.slint";
import { Lang, Dir } from "../lang.slint";
import { Network, NetState, Security, HiddenSecurity, WifiNetwork, EapMethod, CaSource } from "../network.slint";
import { TdnText, TdnPara, TdnNote, TdnBtn, TdnTextField, TdnField, TdnPressable, TdnStyle, TdnSpinner, TdnToggleRow, TdnDialog, TdnDialogActions, TdnSelect, TdnListRow, TdnScrollList } from "../components.slint";
import { Card } from "../slintcn/components/card.slint";
import { Separator } from "../slintcn/components/separator.slint";
import { Tokens } from "../slintcn/theme/tokens.slint";
import { Icon } from "../slintcn/components/icon.slint";
import { LucidePaths } from "../slintcn/components/lucide-paths.slint";
import { ScrollView } from "std-widgets.slint";

component WifiIcon inherits Rectangle {
    in property <int> strength: 3;

    width: 1.25rem;
    height: self.width;
    accessible-role: none;

    Icon {
        commands: LucidePaths.wifi-dot;
        size: parent.width;
    }

    for arc[i] in [LucidePaths.wifi-1, LucidePaths.wifi-2, LucidePaths.wifi-3]: Icon {
        commands: arc;
        size: parent.width;
        tint: root.strength > i ? Tokens.color-foreground : Tokens.color-foreground.transparentize(0.75);
    }
}

component IconButton inherits TdnPressable {
    in property <string> icon;
    in property <string> label;
    in property <string> description;
    callback clicked;

    focusable: root.enabled || root.busy;
    opens-dialog: true;
    activated => { root.clicked(); }
    accessible-role: button;
    accessible-label: root.label;
    accessible-description: root.description;

    width: self.height;
    height: 1.6rem * Tokens.text-scale;
    border-radius: Tokens.radius-sm;

    Rectangle {
        border-radius: root.border-radius;
        background: root.busy ? transparent
            : !root.enabled ? TdnStyle.accent.transparentize(0.92)
            : root.pressed ? TdnStyle.accent.transparentize(0.6)
            : root.has-hover ? TdnStyle.accent.transparentize(0.75)
            : TdnStyle.accent.transparentize(0.85);
        animate background { duration: Tokens.motion-fast; }
    }

    if root.busy: TdnSpinner {
        width: parent.height * 0.7;
    }

    if !root.busy: Icon {
        commands: root.icon;
        size: parent.height * 0.6;
        tint: root.enabled ? TdnStyle.accent : Tokens.color-muted-foreground;
    }
}

component StatusIcon inherits Rectangle {
    in property <bool> ok: true;
    in property <string> label;
    in property <string> description;

    accessible-role: image;
    accessible-label: root.label;
    accessible-description: root.description;

    width: self.height;
    height: 1.6rem * Tokens.text-scale;
    border-radius: Tokens.radius-sm;
    background: root.ok ? Tokens.color-affirm.transparentize(0.75) : Tokens.color-secondary;

    Icon {
        commands: root.ok ? LucidePaths.check : LucidePaths.x-mark;
        size: parent.height * 0.6;
        tint: root.ok ? Tokens.color-foreground : Tokens.color-muted-foreground;
    }
}

component OutlineBtn inherits TdnBtn {
    in-dialog: true;
    outline: true;
    min-size: 1.8rem;
    padding-x: 0.6rem;
}

component StartRow inherits HorizontalLayout {
    alignment: Dir.start;
    min-height: 2.25rem;
}

component NetworkRow inherits VerticalLayout {
    in property <WifiNetwork> net;
    in property <bool> wired;
    in property <length> gutter;

    property <bool> connected: root.wired ? Network.wired : root.net.connected;
    property <bool> enterprise: root.net.security == Security.enterprise || root.net.security == Security.enterprise-tls;
    property <bool> wants-focus: !root.wired && Network.focus-ssid == root.net.ssid;
    property <string> error: !root.wired && Network.error-ssid == root.net.ssid && Network.error-id != ""
        && Network.password-ssid == "" && !Network.enterprise-open && !Network.hidden-open
        ? Lang.t(Network.error-id, []) : "";
    property <string> note: root.error != "" ? root.error
        : root.net.security == Security.unsupported ? Lang.t("page-internet-security-unsupported", []) : "";
    property <string> info: root.wired ? "" : Lang.t("page-internet-network-info", [
        { key: "security", value: Lang.t(
            root.net.security == Security.open ? "page-internet-security-open"
            : root.net.security == Security.password ? "page-internet-security-password"
            : root.enterprise ? "page-internet-security-enterprise"
            : "page-internet-security-unsupported", []) },
        { key: "bars", value: root.net.strength },
    ]);

    function connect() {
        if root.net.known || root.net.security == Security.open {
            Network.try-connect(root.net.ssid, "");
        } else if root.enterprise {
            Network.open-enterprise(root.net.ssid, false, root.net.security == Security.enterprise-tls);
        } else {
            Network.password-ssid = root.net.ssid;
        }
    }

    function refocus() {
        if !root.wants-focus { return; }
        if Network.focus-ip || root.connected {
            ip-btn.focus();
        } else {
            connect-btn.focus();
        }
    }

    init => { root.refocus(); }
    changed wants-focus => { root.refocus(); }
    changed connected => { root.refocus(); }

    HorizontalLayout {
        height: 2.6rem;
        spacing: 0.6rem;
        padding-left: 0.25rem;
        padding-right: 0.25rem + root.gutter;

        VerticalLayout {
            alignment: center;
            horizontal-stretch: 0;

            WifiIcon {
                visible: !root.wired;
                strength: root.net.strength;
            }
        }

        TdnText {
            layout-order: Dir.order(1);
            text: root.wired ? Lang.t("page-internet-wired", []) : root.net.ssid;
            horizontal-stretch: 1;
            min-width: 0;
            font-size: 1.05 * Tokens.text-rem;
            horizontal-alignment: Dir.text-start;
            overflow: elide;
        }

        VerticalLayout {
            layout-order: Dir.order(2);
            width: 0.9rem * Tokens.text-scale;
            horizontal-stretch: 0;
            alignment: center;

            if root.net.security != Security.open: Image {
                source: @image-url("../../data/icons/lock-symbolic.svg");
                width: parent.width;
                height: self.width;
                colorize: Tokens.color-muted-foreground;
                accessible-role: none;
            }
        }

        VerticalLayout {
            layout-order: Dir.order(3);
            alignment: center;
            horizontal-stretch: 0;

            ip-btn := TdnBtn {
                outline: true;
                icon: @image-url("../../data/icons/systemsettings-symbolic.svg");
                icon-size: 0.95rem;
                accessible-label: Lang.t("page-internet-ip", [{ key: "name", value: root.wired ? Lang.t("page-internet-wired", []) : root.net.ssid }]);
                accessible-description: root.net.connected ? Lang.t("page-internet-connected", []) + "\n" + root.info : "";
                min-size: 1.6rem;
                padding-x: 0.3rem;
                clicked => { Network.open-ip(root.net.ssid); }
                changed has-focus => {
                    if self.has-focus {
                        Network.focus-ssid = root.net.ssid;
                        Network.focus-ip = true;
                    } else if Network.focus-ssid == root.net.ssid && Network.focus-ip {
                        Network.focus-ssid = "";
                    }
                }
            }
        }

        VerticalLayout {
            layout-order: Dir.order(4);
            width: 1.6rem * Tokens.text-scale;
            horizontal-stretch: 0;
            alignment: center;

            Rectangle {
                height: 1.6rem * Tokens.text-scale;

                if root.connected || root.wired: StatusIcon {
                    ok: root.connected;
                    label: Lang.t(root.connected ? "page-internet-connected" : "page-internet-unplugged", []);
                    description: root.info;
                }

                connect-btn := IconButton {
                    visible: !root.connected && !root.wired;
                    icon: Lang.rtl ? LucidePaths.arrow-left : LucidePaths.arrow-right;
                    label: Lang.t("page-internet-connect-to", [{ key: "ssid", value: root.net.ssid }]);
                    description: root.error != "" ? root.error + "\n" + root.info : root.info;
                    busy: !root.wired && Network.connecting-ssid == root.net.ssid;
                    enabled: self.visible && Network.connecting-ssid == "" && root.net.security != Security.unsupported;
                    clicked => { root.connect(); }
                    changed has-focus => {
                        if self.has-focus {
                            Network.focus-ssid = root.net.ssid;
                            Network.focus-ip = false;
                        } else if Network.focus-ssid == root.net.ssid && !Network.focus-ip && !root.net.connected {
                            Network.focus-ssid = "";
                        }
                    }
                }
            }
        }
    }

    if root.note != "": TdnPara {
        text: root.note;
        color: root.error != "" ? Tokens.color-destructive : Tokens.color-muted-foreground;
        font-size: 0.9 * Tokens.text-rem;
    }
}

export component NetworkPage inherits TdnPage {
    pageid: "internet";
    step_i: 1;
    intercept-next: !Network.online;
    next-intercepted => {
        Network.offline-prompt-explicit = false;
        Network.offline-prompt = true;
    }
    forward-focus: device-name;

    property <bool> radio-off: Network.wifi-available && (!Network.wifi-enabled || !Network.wifi-hardware-enabled);
    property <bool> wifi: Network.wifi-available && !root.radio-off;
    property <length> scrollbar-gutter: 0.9rem;

    HorizontalLayout {
        spacing: 1.5rem;

        VerticalLayout {
            alignment: start;
            horizontal-stretch: 0;
            width: 15rem;
            spacing: 1.5rem;

            TdnPara {
                text: Lang.t("page-internet-desc", []);
                font-size: 1.1 * Tokens.text-rem;
            }

            VerticalLayout {
                alignment: start;
                spacing: 0.75rem;

                // NetworkManager doesn't detect every captive portal
                StartRow {
                    TdnBtn {
                        primary: true;
                        enter-hint: false;
                        text: Lang.t(Network.portal-open ? "page-internet-portal-close" : "page-internet-portal", []);
                        enabled: Network.state != NetState.offline && Network.state != NetState.connecting;
                        clicked => { Network.toggle-portal(); }
                    }
                }

                StartRow {
                    TdnBtn {
                        text: Lang.t(Network.proxy-url != "" ? "page-internet-proxy-on" : "page-internet-proxy", []);
                        outline: true;
                        clicked => {
                            Network.proxy-error-id = "";
                            Network.proxy-open = true;
                        }
                    }
                }

                if !Network.online || Network.persist-offline-btn: StartRow {
                    TdnBtn {
                        text: Lang.t("page-internet-offline-choose", []);
                        background-color: Tokens.color-destructive-solid;
                        foreground-color: Tokens.color-destructive-foreground;
                        clicked => {
                            Network.offline-prompt-explicit = true;
                            Network.offline-prompt = true;
                        }
                    }
                }
            }
        }

        VerticalLayout {
            layout-order: Dir.order(1);
            horizontal-stretch: 1;
            spacing: 1rem;

            Card {
                vertical-stretch: 1;
                card-radius: md;

                VerticalLayout {
                    padding: 0.6rem;
                    spacing: 0.5rem;

                    if Network.ethernet: NetworkRow {
                        wired: true;
                        gutter: root.scrollbar-gutter;
                    }

                    if Network.ethernet && Network.networks.length > 0: Separator { }

                    if !Network.wifi-available: TdnNote {
                        vertical-stretch: 1;
                        horizontal-alignment: center;
                        text: Lang.t("page-internet-no-wifi", []);
                    }

                    if root.radio-off: VerticalLayout {
                        vertical-stretch: 1;
                        alignment: start;
                        spacing: 0.75rem;

                        TdnNote {
                            text: Lang.t(Network.wifi-hardware-enabled ? "page-internet-wifi-off" : "page-internet-wifi-off-hardware", []);
                        }

                        if Network.wifi-hardware-enabled: HorizontalLayout {
                            alignment: Dir.start;

                            TdnBtn {
                                text: Lang.t("page-internet-wifi-enable", []);
                                min-size: 1.9rem;
                                clicked => { Network.enable-wifi(); }
                            }
                        }
                    }

                    if root.wifi && Network.networks.length == 0: TdnNote {
                        vertical-stretch: 1;
                        horizontal-alignment: center;
                        text: Lang.t(Network.scanning ? "page-internet-scanning" : "page-internet-no-networks", []);
                    }

                    if root.wifi && Network.networks.length > 0: ScrollView {
                        vertical-stretch: 1;

                        VerticalLayout {
                            alignment: start;
                            padding-right: root.scrollbar-gutter;

                            for net in Network.networks: NetworkRow {
                                net: net;
                            }
                        }
                    }

                    if root.wifi: HorizontalLayout {
                        alignment: center;
                        spacing: 0.5rem;

                        TdnBtn {
                            text: Lang.t(Network.scanning ? "page-internet-scanning" : "page-internet-refresh", []);
                            enabled: !Network.scanning;
                            min-size: 1.9rem;
                            clicked => { Network.refresh(); }
                        }

                        TdnBtn {
                            layout-order: Dir.order(1);
                            text: Lang.t("page-internet-hidden", []);
                            min-size: 1.9rem;
                            enabled: Network.connecting-ssid == "";
                            clicked => { Network.open-hidden(); }
                        }
                    }
                }
            }

            device-name := TdnTextField {
                vertical-stretch: 0;
                label: Lang.t("page-internet-devicename", []);
                help: Network.hostname != ""
                    ? Lang.t("page-internet-hostname", [{ key: "hostname", value: Network.hostname }])
                    : Lang.t("page-internet-devicename-desc", []);
                text <=> Network.device-name;
                accepted => { root.try-next(); }
            }
        }
    }
}

export component PasswordDialog inherits TdnDialog {
    property <bool> busy: Network.connecting-ssid == Network.password-ssid;

    title: Lang.t("page-internet-connect-to", [{ key: "ssid", value: Network.password-ssid }]);
    dismissed => {
        Network.dismissed-ssid = Network.password-ssid;
        Network.password-ssid = "";
        Network.error-id = "";
        Network.error-ssid = "";
    }

    function submit() {
        if !root.busy && pw.text != "" {
            Network.try-connect(Network.password-ssid, pw.text);
        }
    }

    pw := TdnTextField {
        in-dialog: true;
        label: Lang.t("page-internet-password", []);
        error: Network.error-ssid == Network.password-ssid && Network.error-id != "" ? Lang.t(Network.error-id, []) : "";
        password: true;
        auto-focus: true;
        enabled: !root.busy;
        accepted => { root.submit(); }
    }

    TdnDialogActions {
        busy: root.busy;
        submit-text: Lang.t("page-internet-connect", []);
        submit-enabled: !root.busy && pw.text != "";
        cancelled => { root.dismissed(); }
        submitted => { root.submit(); }
    }
}

export component HiddenDialog inherits TdnDialog {
    property <[HiddenSecurity]> securities: [HiddenSecurity.wpa, HiddenSecurity.wpa3, HiddenSecurity.open, HiddenSecurity.enterprise];
    property <int> security-index: 0;
    property <HiddenSecurity> security: root.securities[root.security-index];
    property <bool> needs-password: root.security == HiddenSecurity.wpa || root.security == HiddenSecurity.wpa3;
    property <string> ssid;
    property <string> password;
    property <bool> busy: Network.connecting-ssid != "";
    property <int> wpa-psk-min-length: 8;
    property <bool> complete: Network.trim(root.ssid) != "" && (!root.needs-password
        || (root.security == HiddenSecurity.wpa3 ? root.password != "" : root.password.character-count >= root.wpa-psk-min-length));

    property <string> error: Network.hidden-ssid != "" && Network.error-ssid == Network.hidden-ssid && Network.error-id != ""
        ? Lang.t(Network.error-id, []) : "";
    property <bool> error-on-password: root.needs-password
        && (Network.error-id == "page-internet-error-password" || Network.error-id == "page-internet-error-password-length");

    title: Lang.t("page-internet-hidden-title", []);
    init => { Network.hidden-visit += 1; }
    dismissed => {
        Network.hidden-open = false;
        Network.error-id = "";
        Network.error-ssid = "";
        Network.hidden-ssid = "";
    }

    function submit() {
        if root.busy || !root.complete { return; }
        if root.security == HiddenSecurity.enterprise {
            Network.hidden-open = false;
            Network.open-enterprise(root.ssid, false, false);
        } else {
            Network.try-connect-hidden(root.ssid, root.security, root.needs-password ? root.password : "");
        }
    }

    TdnTextField {
        in-dialog: true;
        label: Lang.t("page-internet-hidden-ssid", []);
        error: root.error-on-password ? "" : root.error;
        text <=> root.ssid;
        auto-focus: true;
        enabled: !root.busy;
        accepted => { root.submit(); }
    }

    TdnSelect {
        in-dialog: true;
        label: Lang.t("page-internet-hidden-security", []);
        options: [
            Lang.t("page-internet-hidden-wpa", []),
            Lang.t("page-internet-hidden-wpa3", []),
            Lang.t("page-internet-hidden-open", []),
            Lang.t("page-internet-hidden-enterprise", []),
        ];
        index <=> root.security-index;
        enabled: !root.busy;
    }

    if root.needs-password: TdnTextField {
        in-dialog: true;
        label: Lang.t("page-internet-password", []);
        error: root.error-on-password ? root.error : "";
        text <=> root.password;
        password: true;
        enabled: !root.busy;
        accepted => { root.submit(); }
    }

    TdnDialogActions {
        busy: root.busy;
        submit-text: Lang.t(root.security == HiddenSecurity.enterprise ? "next" : "page-internet-connect", []);
        submit-enabled: !root.busy && root.complete;
        cancelled => { root.dismissed(); }
        submitted => { root.submit(); }
    }
}

global FilePicker {
    in-out property <string> picking;
    in-out property <string> picked-from;

    public function stop() {
        picked-from = picking;
        picking = "";
    }
}

component FileRow inherits TdnField {
    in property <string> key;
    in-out property <string> path;
    in property <bool> enabled: true;

    property <string> file: root.path == "" ? Lang.t("page-internet-8021x-nofile", []) : Network.file-name(root.path);

    init => {
        if FilePicker.picked-from == root.key {
            choose.focus();
            FilePicker.picked-from = "";
        }
    }

    HorizontalLayout {
        spacing: 0.5rem;

        TdnText {
            text: root.file;
            color: root.path == "" ? Tokens.color-muted-foreground : Tokens.color-foreground;
            horizontal-alignment: Dir.text-start;
            overflow: elide;
        }

        if root.path != "": OutlineBtn {
            layout-order: Dir.order(1);
            text: "✕";
            accessible-label: Lang.t("page-internet-8021x-clear-for", [{ key: "field", value: root.label }]);
            accessible-description: root.file;
            padding-x: 0.5rem;
            enabled: root.enabled;
            clicked => { root.path = ""; }
        }

        choose := OutlineBtn {
            layout-order: Dir.order(2);
            text: Lang.t("page-internet-8021x-choose", []);
            accessible-label: Lang.t("page-internet-8021x-choose-for", [{ key: "field", value: root.label }]);
            accessible-description: root.file;
            enabled: root.enabled;
            clicked => { FilePicker.picking = root.key; }
        }
    }
}

component FileBrowser inherits VerticalLayout {
    in property <bool> pac;
    in-out property <bool> show-all;
    in property <length> list-height: 12rem;
    callback picked(string);
    callback cancelled();

    spacing: 0.75rem;
    init => {
        Network.browse(Network.browse-dir, root.pac, root.show-all);
        cancel.focus();
    }

    HorizontalLayout {
        spacing: 0.4rem;
        alignment: Dir.start;

        for place[i] in Network.browse-places: OutlineBtn {
            layout-order: Dir.order(i);
            text: Lang.t(place.name, []);
            clicked => { Network.browse(place.path, root.pac, root.show-all); }
        }
    }

    HorizontalLayout {
        spacing: 0.5rem;

        OutlineBtn {
            text: "↑";
            accessible-label: Lang.t("page-internet-files-up", []);
            padding-x: 0.5rem;
            enabled: Network.browse-parent != "";
            clicked => { Network.browse(Network.browse-parent, root.pac, root.show-all); }
        }

        TdnText {
            layout-order: Dir.order(1);
            text: Network.browse-dir;
            color: Tokens.color-muted-foreground;
            horizontal-alignment: Dir.text-start;
            overflow: elide;
        }
    }

    Rectangle {
        height: root.list-height;
        border-radius: Tokens.radius-md;
        border-width: 1px;
        border-color: Tokens.color-border-hairline-strong;
        background: Tokens.color-card;

        if Network.browse-entries.length == 0: TdnNote {
            width: parent.width - 2rem;
            horizontal-alignment: center;
            text: Lang.t(root.pac ? "page-internet-files-empty-pac" : "page-internet-files-empty", []);
        }

        if Network.browse-entries.length > 0: ScrollView {
            VerticalLayout {
                alignment: start;
                padding: 0.25rem;
                padding-right: 0.9rem;

                for entry in Network.browse-entries: TdnListRow {
                    in-dialog: true;
                    focusable: true;
                    text: entry.dir ? entry.name + "/" : entry.name;
                    clicked => {
                        if entry.dir {
                            Network.browse(entry.path, root.pac, root.show-all);
                        } else {
                            root.picked(entry.path);
                        }
                    }
                }
            }
        }
    }

    TdnToggleRow {
        in-dialog: true;
        text: Lang.t("page-internet-files-all", []);
        checked: root.show-all;
        toggled(on) => {
            root.show-all = on;
            Network.browse(Network.browse-dir, root.pac, on);
        }
    }

    HorizontalLayout {
        alignment: Dir.start;

        cancel := TdnBtn {
            in-dialog: true;
            text: Lang.t("cancel", []);
            clicked => { root.cancelled(); }
        }
    }
}

export component EnterpriseDialog inherits TdnDialog {
    property <bool> busy: Network.enterprise-busy;
    property <bool> wired: Network.enterprise-wired;

    property <bool> tls-only: Network.enterprise-tls-only && !root.wired;
    property <[EapMethod]> methods: root.tls-only ? [EapMethod.tls]
        : root.wired
        ? [EapMethod.peap, EapMethod.ttls, EapMethod.tls, EapMethod.fast, EapMethod.pwd, EapMethod.md5]
        : [EapMethod.peap, EapMethod.ttls, EapMethod.tls, EapMethod.fast, EapMethod.pwd, EapMethod.leap];
    property <[string]> method-names: root.tls-only ? ["TLS"] : [
        Lang.t("page-internet-8021x-peap", []),
        Lang.t("page-internet-8021x-ttls", []),
        "TLS",
        "FAST",
        "PWD",
        root.wired ? "MD5" : "LEAP",
    ];
    property <int> method-index;
    property <EapMethod> method: root.methods[root.method-index];
    property <[string]> inner-ids: root.method == EapMethod.ttls
        ? ["pap", "mschap", "mschapv2", "mschapv2-plain", "chap", "md5", "gtc"]
        : root.method == EapMethod.fast ? ["gtc", "mschapv2"]
        : ["mschapv2", "md5", "gtc"];
    property <[string]> inner-names: root.method == EapMethod.ttls
        ? ["PAP", "MSCHAP", "MSCHAPv2", Lang.t("page-internet-8021x-mschapv2-noeap", []), "CHAP", "MD5", "GTC"]
        : root.method == EapMethod.fast ? ["GTC", "MSCHAPv2"]
        : ["MSCHAPv2", "MD5", "GTC"];
    property <int> inner-index;
    property <bool> tunneled: root.method == EapMethod.peap || root.method == EapMethod.ttls || root.method == EapMethod.fast;
    property <bool> uses-ca: root.method == EapMethod.peap || root.method == EapMethod.ttls || root.method == EapMethod.tls;

    property <string> username;
    property <string> password;
    property <string> anonymous-identity;
    property <bool> anonymous-touched;
    property <string> domain;
    property <bool> domain-touched;
    property <int> ca-index;
    property <CaSource> ca: root.ca-index == 0 ? CaSource.system : root.ca-index == 1 ? CaSource.file : CaSource.none;
    property <string> ca-cert;
    property <int> peap-version;
    property <string> client-cert;
    property <string> private-key;
    property <string> private-key-password;
    property <bool> fast-provisioning: true;
    property <int> fast-mode;
    property <string> pac-file;
    property <bool> advanced;
    property <bool> show-all-files;

    property <string> error: Network.enterprise-error-id == "" ? ""
        : Lang.t(Network.enterprise-error-id != "page-internet-error-password" ? Network.enterprise-error-id
            : root.method == EapMethod.tls ? "page-internet-8021x-error-tls"
            : "page-internet-error-login", []);

    property <bool> complete: root.username != ""
        && (root.method == EapMethod.tls || root.password != "")
        && (!root.uses-ca || (root.ca == CaSource.system ? root.domain != "" : root.ca == CaSource.file ? root.ca-cert != "" : true))
        && (root.method != EapMethod.tls || (root.client-cert != "" && (root.private-key != "" || Network.is-pkcs12(root.client-cert))))
        && (root.method != EapMethod.fast || root.fast-provisioning || root.pac-file != "");

    title: FilePicker.picking != "" ? Lang.t("page-internet-files", [])
        : root.wired ? Lang.t("page-internet-8021x-wired", [])
        : Lang.t("page-internet-connect-to", [{ key: "ssid", value: Network.enterprise-ssid }]);
    dialog-width: 26rem;
    init => {
        Network.enterprise-visit += 1;
        FilePicker.picking = "";
        FilePicker.picked-from = "";
    }
    dismissed => {
        if FilePicker.picking != "" {
            FilePicker.stop();
        } else {
            if !root.wired { Network.dismissed-ssid = Network.enterprise-ssid; }
            Network.enterprise-open = false;
            Network.error-id = "";
            Network.error-ssid = "";
        }
    }

    function picked(path: string) {
        if FilePicker.picking == "ca" { root.ca-cert = path; }
        if FilePicker.picking == "client" { root.client-cert = path; }
        if FilePicker.picking == "key" { root.private-key = path; }
        if FilePicker.picking == "pac" { root.pac-file = path; }
        FilePicker.stop();
    }

    function submit() {
        if root.busy || !root.complete { return; }
        Network.try-connect-enterprise({
            wired: root.wired,
            ssid: root.wired ? "" : Network.enterprise-ssid,
            method: root.method,
            inner: root.tunneled ? root.inner-ids[root.inner-index] : "",
            username: root.username,
            password: root.method == EapMethod.tls ? "" : root.password,
            anonymous-identity: root.tunneled ? root.anonymous-identity : "",
            ca: root.uses-ca ? root.ca : CaSource.none,
            ca-cert: root.uses-ca && root.ca == CaSource.file ? root.ca-cert : "",
            domain: root.uses-ca ? root.domain : "",
            peap-version: root.method == EapMethod.peap ? root.peap-version : 0,
            client-cert: root.method == EapMethod.tls ? root.client-cert : "",
            private-key: root.method == EapMethod.tls && !Network.is-pkcs12(root.client-cert) ? root.private-key : "",
            private-key-password: root.method == EapMethod.tls ? root.private-key-password : "",
            fast-provisioning: root.method == EapMethod.fast && root.fast-provisioning ? root.fast-mode + 1 : 0,
            pac-file: root.method == EapMethod.fast ? root.pac-file : "",
        });
    }

    if FilePicker.picking != "": FileBrowser {
        pac: FilePicker.picking == "pac";
        show-all <=> root.show-all-files;
        list-height: min(12rem, root.height - 22rem);
        picked(path) => { root.picked(path); }
        cancelled => { FilePicker.stop(); }
    }

    if FilePicker.picking == "": TdnScrollList {
        TdnField {
            label: Lang.t("page-internet-8021x-method", []);

            TdnSelect {
                in-dialog: true;
                label: Lang.t("page-internet-8021x-method", []);
                options: root.method-names;
                index <=> root.method-index;
                enabled: !root.busy;
                changed => { root.inner-index = 0; }
            }
        }

        TdnTextField {
            in-dialog: true;
            label: Lang.t(root.method == EapMethod.tls ? "page-internet-8021x-identity" : "page-internet-username", []);
            input-description: root.error;
            text <=> root.username;
            placeholder: Lang.t("page-internet-username-placeholder", []);
            auto-focus: FilePicker.picked-from == "";
            enabled: !root.busy;
            edited(text) => {
                if !root.domain-touched { root.domain = Network.realm(text); }
                if !root.anonymous-touched {
                    root.anonymous-identity = Network.realm(text) == "" ? "" : "anonymous@" + Network.realm(text);
                }
            }
            accepted => { root.submit(); }
        }

        if root.method != EapMethod.tls: TdnTextField {
            in-dialog: true;
            label: Lang.t("page-internet-password", []);
            input-description: root.error;
            text <=> root.password;
            password: true;
            enabled: !root.busy;
            accepted => { root.submit(); }
        }

        if root.method == EapMethod.tls: FileRow {
            key: "client";
            label: Lang.t("page-internet-8021x-client-cert", []);
            path <=> root.client-cert;
            enabled: !root.busy;
        }

        if root.method == EapMethod.tls && !Network.is-pkcs12(root.client-cert): FileRow {
            key: "key";
            label: Lang.t("page-internet-8021x-private-key", []);
            path <=> root.private-key;
            enabled: !root.busy;
        }

        if root.method == EapMethod.tls: TdnTextField {
            in-dialog: true;
            label: Lang.t("page-internet-8021x-key-password", []);
            help: Lang.t("page-internet-8021x-key-password-desc", []);
            text <=> root.private-key-password;
            password: true;
            enabled: !root.busy;
            accepted => { root.submit(); }
        }

        if root.uses-ca: TdnField {
            label: Lang.t("page-internet-8021x-ca", []);

            TdnSelect {
                in-dialog: true;
                label: Lang.t("page-internet-8021x-ca", []);
                options: [
                    Lang.t("page-internet-8021x-ca-system", []),
                    Lang.t("page-internet-8021x-ca-file", []),
                    Lang.t("page-internet-8021x-ca-none", []),
                ];
                index <=> root.ca-index;
                enabled: !root.busy;
            }
        }

        if root.uses-ca && root.ca == CaSource.file: FileRow {
            key: "ca";
            label: Lang.t("page-internet-8021x-ca-cert", []);
            path <=> root.ca-cert;
            enabled: !root.busy;
        }

        if root.uses-ca && root.ca != CaSource.none: TdnTextField {
            in-dialog: true;
            label: Lang.t("page-internet-server", []);
            help: Lang.t(root.ca == CaSource.system ? "page-internet-server-desc" : "page-internet-server-desc-optional", []);
            text <=> root.domain;
            placeholder: "radius.example.edu";
            enabled: !root.busy;
            edited => { root.domain-touched = true; }
            accepted => { root.submit(); }
        }

        if root.uses-ca && root.ca == CaSource.none: TdnPara {
            text: Lang.t("page-internet-8021x-ca-none-warn", []);
            color: Tokens.color-destructive;
        }

        if root.method == EapMethod.fast: TdnToggleRow {
            in-dialog: true;
            text: Lang.t("page-internet-8021x-fast-provisioning", []);
            checked: root.fast-provisioning;
            toggled(on) => { root.fast-provisioning = on; }
            accepted => { root.submit(); }
        }

        if root.method == EapMethod.fast && root.fast-provisioning: TdnSelect {
            in-dialog: true;
            label: Lang.t("page-internet-8021x-fast-provisioning", []);
            options: [
                Lang.t("page-internet-8021x-fast-anonymous", []),
                Lang.t("page-internet-8021x-fast-authenticated", []),
                Lang.t("page-internet-8021x-fast-both", []),
            ];
            index <=> root.fast-mode;
            enabled: !root.busy;
        }

        if root.method == EapMethod.fast: FileRow {
            key: "pac";
            label: Lang.t("page-internet-8021x-pac", []);
            help: root.fast-provisioning ? Lang.t("page-internet-8021x-pac-desc", []) : "";
            path <=> root.pac-file;
            enabled: !root.busy;
        }

        if root.tunneled && !root.advanced: HorizontalLayout {
            alignment: Dir.start;

            OutlineBtn {
                text: Lang.t("page-internet-advanced", []);
                padding-x: 1rem;
                clicked => { root.advanced = true; }
            }
        }

        if root.tunneled && root.advanced: TdnField {
            label: Lang.t("page-internet-8021x-inner", []);

            TdnSelect {
                in-dialog: true;
                label: Lang.t("page-internet-8021x-inner", []);
                options: root.inner-names;
                index <=> root.inner-index;
                enabled: !root.busy;
            }
        }

        if root.method == EapMethod.peap && root.advanced: TdnField {
            label: Lang.t("page-internet-8021x-peap-version", []);

            TdnSelect {
                in-dialog: true;
                label: Lang.t("page-internet-8021x-peap-version", []);
                options: [Lang.t("page-internet-8021x-automatic", []), Lang.t("page-internet-8021x-version", [{ key: "version", value: "0" }]), Lang.t("page-internet-8021x-version", [{ key: "version", value: "1" }])];
                index <=> root.peap-version;
                enabled: !root.busy;
            }
        }

        if root.tunneled && root.advanced: TdnTextField {
            in-dialog: true;
            label: Lang.t("page-internet-8021x-anonymous", []);
            help: Lang.t("page-internet-8021x-anonymous-desc", []);
            text <=> root.anonymous-identity;
            enabled: !root.busy;
            edited => { root.anonymous-touched = true; }
            accepted => { root.submit(); }
        }
    }

    if FilePicker.picking == "" && root.error != "": TdnPara {
        text: root.error;
        color: Tokens.color-destructive;
        accessible-role: text;
        accessible-label: root.error;
    }

    if FilePicker.picking == "": TdnDialogActions {
        busy: root.busy;
        submit-text: Lang.t("page-internet-connect", []);
        submit-enabled: !root.busy && root.complete;
        cancelled => { root.dismissed(); }
        submitted => { root.submit(); }
    }
}

export component OfflineDialog inherits TdnDialog {
    in property <bool> explicit;
    callback skipped;

    title: Lang.t(root.explicit ? "page-internet-offline-choose-title" : "page-internet-offline", []);
    description: Lang.t(root.explicit ? "page-internet-offline-choose-desc" : "page-internet-offline-desc", []);
    dialog-width: 24rem;
    dismissed => { Network.offline-prompt = false; }
    init => { back.focus(); }

    HorizontalLayout {
        alignment: Dir.end;
        spacing: 0.5rem;

        back := TdnBtn {
            in-dialog: true;
            text: Lang.t("prev", []);
            clicked => { root.dismissed(); }
        }

        TdnBtn {
            layout-order: Dir.order(1);
            in-dialog: true;
            text: Lang.t(root.explicit ? "page-internet-offline-choose" : "skip", []);
            background-color: Tokens.color-destructive-tint;
            foreground-color: Tokens.color-destructive;
            clicked => { root.skipped(); }
        }
    }
}

export component ProxyDialog inherits TdnDialog {
    title: Lang.t("page-internet-proxy", []);
    description: Lang.t("page-internet-proxy-desc", []);
    dialog-width: 24rem;
    init => {
        Network.proxy-visit += 1;
        Network.proxy-busy = false;
    }
    dismissed => {
        Network.proxy-open = false;
        Network.proxy-busy = false;
    }

    property <bool> persist: Network.proxy-persist;
    property <string> full-url: server.text == Network.proxy-public ? Network.proxy-url : server.text;
    property <bool> already-checked: root.full-url == Network.proxy-url && bypass.text == Network.proxy-bypass
        && Network.proxy-checked-on == Network.primary-connection;

    function submit() {
        if Network.proxy-busy || server.text == "" {
            return;
        }
        if root.already-checked {
            Network.proxy-persist = root.persist;
            root.dismissed();
        } else {
            Network.try-set-proxy(root.full-url, bypass.text, root.persist);
        }
    }

    server := TdnTextField {
        in-dialog: true;
        label: Lang.t("page-internet-proxy-server", []);
        error: Network.proxy-error-id != "" ? Lang.t(Network.proxy-error-id, []) : "";
        text: Network.proxy-public;
        placeholder: "proxy.example.com:3128";
        auto-focus: true;
        enabled: !Network.proxy-busy;
        accepted => { bypass.focus(); }
    }

    bypass := TdnTextField {
        in-dialog: true;
        label: Lang.t("page-internet-proxy-bypass", []);
        help: Lang.t("page-internet-proxy-bypass-desc", []);
        text: Network.proxy-bypass;
        enabled: !Network.proxy-busy;
        accepted => { root.submit(); }
    }

    TdnToggleRow {
        in-dialog: true;
        enabled: !Network.proxy-busy;
        text: Lang.t("page-internet-proxy-persist", []);
        checked: root.persist;
        toggled(on) => { root.persist = on; }
        accepted => { root.submit(); }
    }

    TdnDialogActions {
        busy: Network.proxy-busy;
        submit-text: Lang.t("page-internet-save", []);
        submit-enabled: !Network.proxy-busy && server.text != "";
        cancelled => { root.dismissed(); }
        submitted => { root.submit(); }

        if Network.proxy-url != "": TdnBtn {
            layout-order: Dir.order(1);
            in-dialog: true;
            text: Lang.t("page-internet-proxy-remove", []);
            enabled: !Network.proxy-busy;
            background-color: Tokens.color-destructive-tint;
            foreground-color: Tokens.color-destructive;
            clicked => { Network.try-set-proxy("", "", Network.proxy-persist); }
        }
    }
}

export component IpDialog inherits TdnDialog {
    property <bool> busy: Network.ip-busy || Network.ip-loading;
    property <string> error: Network.ip-error-id == "" ? "" : Lang.t(Network.ip-error-id, []);
    property <bool> address-error: Network.ip-error-id == "page-internet-ip-error-address";
    property <bool> gateway-error: Network.ip-error-id == "page-internet-ip-error-gateway";

    title: Lang.t("page-internet-ip", [{ key: "name", value: Network.ip-ssid != "" ? Network.ip-ssid : Lang.t("page-internet-wired", []) }]);
    dialog-width: 24rem;
    dismissed => { Network.ip-open = false; }
    init => { if Network.ip-loading { actions.focus-cancel(); } }

    if Network.ip-loading: HorizontalLayout {
        alignment: center;
        TdnSpinner { width: 1.5rem; }
    }

    if !Network.ip-loading: TdnToggleRow {
        in-dialog: true;
        enabled: !root.busy;
        text: Lang.t("page-internet-ip-manual", []);
        checked: Network.ip.manual;
        toggled(on) => { Network.ip.manual = on; }
        accepted => { Network.try-save-ip(); }
        init => { self.focus(); }
    }

    if !Network.ip-loading && Network.ip.manual: HorizontalLayout {
        spacing: 0.75rem;

        TdnTextField {
            min-width: 0;
            horizontal-stretch: 1;
            in-dialog: true;
            label: Lang.t("page-internet-ip-address", []);
            error: root.address-error ? root.error : "";
            text: Network.ip.address;
            placeholder: "192.168.1.20/24";
            enabled: !root.busy;
            edited(text) => { Network.ip.address = text; }
            accepted => { Network.try-save-ip(); }
        }

        TdnTextField {
            layout-order: Dir.order(1);
            min-width: 0;
            horizontal-stretch: 1;
            in-dialog: true;
            label: Lang.t("page-internet-ip-gateway", []);
            error: root.gateway-error ? root.error : "";
            text: Network.ip.gateway;
            placeholder: "192.168.1.1";
            enabled: !root.busy;
            edited(text) => { Network.ip.gateway = text; }
            accepted => { Network.try-save-ip(); }
        }
    }

    if !Network.ip-loading: TdnTextField {
        in-dialog: true;
        label: Lang.t("page-internet-ip-dns", []);
        help: Lang.t(Network.ip.manual ? "page-internet-ip-dns-desc-manual" : "page-internet-ip-dns-desc", []);
        error: root.address-error || root.gateway-error ? "" : root.error;
        text: Network.ip.dns;
        placeholder: "1.1.1.1, 9.9.9.9";
        enabled: !root.busy;
        edited(text) => { Network.ip.dns = text; }
        accepted => { Network.try-save-ip(); }
    }

    if Network.ip-ssid == "" && !Network.ip-loading: HorizontalLayout {
        alignment: Dir.start;

        OutlineBtn {
            text: Lang.t("page-internet-8021x-open", []);
            padding-x: 1rem;
            clicked => {
                Network.ip-open = false;
                Network.open-enterprise("", true, false);
            }
        }
    }

    actions := TdnDialogActions {
        busy: Network.ip-busy;
        submit-text: Lang.t("page-internet-save", []);
        submit-enabled: !root.busy;
        cancelled => { root.dismissed(); }
        submitted => { Network.try-save-ip(); }
    }
}
