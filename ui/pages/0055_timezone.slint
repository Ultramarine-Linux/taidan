import { TdnPage } from "../page.slint";
import { Lang, Dir } from "../lang.slint";
import { Tz, TimeZone } from "../timezone.slint";
import { TdnText, TdnInput, TdnListRow, TdnStyle } from "../components.slint";
import { Card } from "../slintcn/components/card.slint";
import { Tokens } from "../slintcn/theme/tokens.slint";
import { ListView } from "std-widgets.slint";

// the world map, clicking it picks the nearest zone
component WorldMap inherits Rectangle {
    // aspect ratio of `world-map.svg`, 360° of longitude by 142° of latitude
    property <float> aspect: 360 / 142;

    accessible-role: none;

    map := Rectangle {
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        width: min(parent.width, parent.height * root.aspect);
        height: self.width / root.aspect;

        Image {
            width: 100%;
            height: 100%;
            source: @image-url("../../data/icons/world-map.svg");
            colorize: Tokens.color-border-hairline-strong;
        }

        // time zone boundaries, drawn faintly over the land
        Image {
            width: 100%;
            height: 100%;
            source: @image-url("../../data/icons/world-map-zones.svg");
            colorize: Tokens.color-muted-foreground.transparentize(0.6);
        }

        for zone in Tz.zones: Rectangle {
            visible: zone.x >= 0;
            x: zone.x * map.width - self.width / 2;
            y: zone.y * map.height - self.height / 2;
            width: 3px;
            height: self.width;
            border-radius: self.width / 2;
            background: Tokens.color-muted-foreground.transparentize(0.4);
        }

        // the chosen zone, if it's on the map (UTC isn't)
        if Tz.current.x >= 0: Rectangle {
            x: Tz.current.x * map.width - self.width / 2;
            y: Tz.current.y * map.height - self.height / 2;
            width: 0.9rem;
            height: self.width;
            border-radius: self.width / 2;
            border-width: 2px;
            border-color: Tokens.color-background;
            background: TdnStyle.accent;
        }

        TouchArea {
            mouse-cursor: pointer;
            clicked => { Tz.pick-at(self.mouse-x / self.width, self.mouse-y / self.height); }
        }
    }
}

export component TimezonePage inherits TdnPage {
    pageid: "timezone";
    step_i: 1;
    forward-focus: search;

    property <bool> searching: search.text != "";
    property <length> row-height: 2.25rem;
    // result moved to with the arrow keys, -1 until the user does so
    property <int> cursor: -1;
    // row of the current zone in the results, -1 if it isn't there, see the finder below
    property <int> current-row: -1;
    // the result Enter picks and that's highlighted: the one moved to, else the current zone,
    // else the first
    property <int> active-row: cursor >= 0 && cursor < Tz.results.length ? cursor
        : current-row >= 0 && current-row < Tz.results.length && Tz.results[current-row].id == Tz.current.id ? current-row
        : 0;

    function pick(zone: TimeZone) {
        Tz.pick(zone.id);
        search.text = "";
        cursor = -1;
        Tz.search("");
    }

    function move-cursor(delta: int) {
        if !searching || Tz.results.length == 0 { return; }
        cursor = max(0, min(Tz.results.length - 1, active-row + delta));
        // keep the row in view
        let top = cursor * row-height;
        if top < -list.content-y {
            list.content-y = -top;
        } else if top + row-height > -list.content-y + list.visible-height {
            list.content-y = list.visible-height - top - row-height;
        }
    }

    VerticalLayout {
        spacing: 0.75rem;

        search := TdnInput {
            icon: @image-url("../../data/icons/system-search-symbolic.svg");
            placeholder: Lang.t("page-timezone-search", []);
            // the arrow keys move through the results while the focus stays here, so screen
            // readers hear the one Enter would pick from the description changing
            description: !root.searching ? ""
                : Tz.results.length == 0 ? Lang.t("page-timezone-none", [])
                : Lang.place(Tz.results[root.active-row].city, Tz.results[root.active-row].region);
            edited(text) => {
                cursor = -1;
                list.content-y = 0;
                Tz.search(text);
            }
            // Enter takes the highlighted match, see `active-row`
            accepted => {
                if root.searching && Tz.results.length > 0 { root.pick(Tz.results[root.active-row]); }
                else if !root.searching { root.try-next(); }
            }
            key-pressed(event) => {
                if !root.searching { return reject; }
                if event.text == Key.DownArrow { move-cursor(1); return accept; }
                if event.text == Key.UpArrow { move-cursor(-1); return accept; }
                if event.text == Key.PageDown { move-cursor(10); return accept; }
                if event.text == Key.PageUp { move-cursor(-10); return accept; }
                reject
            }
        }

        Card {
            vertical-stretch: 1;
            card-radius: md;

            // finds the current zone's row. `ListView` can't, since it only creates the rows in view
            for zone[i] in Tz.results: Rectangle {
                property <bool> current: zone.id == Tz.current.id;
                width: 0;
                height: 0;
                init => { if self.current { root.current-row = i; } }
                changed current => {
                    if self.current { root.current-row = i; }
                    else if root.current-row == i { root.current-row = -1; }
                }
            }

            if !root.searching: WorldMap {
                x: 0.75rem;
                y: 0.75rem;
                width: parent.width - 1.5rem;
                height: parent.height - 1.5rem;
            }

            if root.searching && Tz.results.length == 0: TdnText {
                text: Lang.t("page-timezone-none", []);
                color: Tokens.color-muted-foreground;
            }

            // not behind an `if`, so the arrow keys can scroll it. hidden when there's nothing to list
            list := ListView {
                visible: root.searching && Tz.results.length > 0;
                x: 0.25rem;
                y: 0.25rem;
                width: parent.width - 0.5rem;
                height: parent.height - 0.5rem;
                horizontal-scrollbar-policy: always-off;

                for zone[i] in Tz.results: TdnListRow {
                    height: root.row-height;
                    text: Lang.place(zone.city, zone.region);
                    secondary: zone.offset;
                    selected: zone.id == Tz.current.id;
                    highlighted: i == root.active-row;
                    clicked => { root.pick(zone); }
                }
            }
        }

        // the chosen zone and its time right now
        HorizontalLayout {
            spacing: 0.5rem;
            property <string> zone-name: Lang.place(Tz.current.city, Tz.current.region);

            TdnText {
                text: parent.zone-name;
                font-weight: Tokens.typography-weight-medium;
                horizontal-alignment: Dir.text-start;
                horizontal-stretch: 1;
                min-width: 0;
                overflow: elide;
            }

            TdnText {
                layout-order: Dir.order(1);
                text: Tz.current.offset + " · " + Tz.current-time;
                color: Tokens.color-muted-foreground;
                horizontal-stretch: 0;
            }
        }
    }
}
