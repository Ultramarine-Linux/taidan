import { TdnPage } from "../page.slint";
import { Lang, Dir } from "../lang.slint";
import { Account } from "../account.slint";
import { Drivers, Install } from "../install.slint";
import { Network } from "../network.slint";
import { Tz } from "../timezone.slint";
import { Tweaks } from "../tweaks.slint";
import { Ims } from "../ims.slint";
import { Cfg } from "../cfg.slint";
import { Modal } from "../modal.slint";
import { TdnText, TdnBtn, TdnToggleRow, TdnScrollList } from "../components.slint";
import { DriverList, DriverRow } from "0100_drivers.slint";
import { UserIcon } from "0040_whoareyou.slint";
import { Card } from "../slintcn/components/card.slint";
import { Tokens } from "../slintcn/theme/tokens.slint";

component SectionTitle inherits TdnText {
    font-size: 1.2 * Tokens.text-rem;
    font-weight: Tokens.typography-weight-medium;
    horizontal-alignment: Dir.text-start;
}

component InfoRow inherits HorizontalLayout {
    in property <image> icon;
    in property <string> label;
    in property <string> value;

    spacing: 0.75rem;

    Image {
        source: root.icon;
        colorize: Tokens.color-foreground;
        width: 1.25rem;
    }

    VerticalLayout {
        layout-order: Dir.order(1);
        alignment: center;

        TdnText {
            text: root.label;
            font-size: Tokens.typography-label-size;
            color: Tokens.color-muted-foreground;
            horizontal-alignment: Dir.text-start;
        }

        TdnText {
            text: root.value;
            horizontal-alignment: Dir.text-start;
            overflow: elide;
        }
    }
}

export component SummaryPage inherits TdnPage {
    pageid: "summary";
    step_i: 3;
    name: Lang.t("page-summary", [{ key: "name", value: Account.first-name(Account.fullname, Account.username) }]);
    next-text: Lang.t("page-summary-confirm", []);
    next-enter-hint: false;

    forward-focus: review;

    review := FocusScope {
        enabled: !Modal.open;
        vertical-stretch: 1;
        // screen readers say nothing for a focused FocusScope without a named role
        accessible-role: groupbox;
        accessible-label: root.name;

        key-pressed(event) => {
            let step = event.text == Key.UpArrow ? 3rem
                : event.text == Key.DownArrow ? -3rem
                : event.text == Key.PageUp ? scroll.visible-height
                : event.text == Key.PageDown ? -scroll.visible-height
                : 0px;
            if step == 0px { return reject; }
            scroll.content-y = min(0, max(scroll.visible-height - scroll.content-height, scroll.content-y + step));
            accept
        }

        scroll := TdnScrollList {
            spacing: 0;

            HorizontalLayout {
                spacing: 2rem;

                VerticalLayout {
                    alignment: start;
                    horizontal-stretch: 1;
                    spacing: 0.75rem;

                    SectionTitle {
                        text: Lang.t("page-summary-account", []);
                    }

                    HorizontalLayout {
                        spacing: 0.75rem;

                        UserIcon {
                            width: 2.75rem;
                        }

                        VerticalLayout {
                            layout-order: Dir.order(1);
                            alignment: center;

                            TdnText {
                                text: Account.fullname != "" ? Account.fullname : Account.username;
                                font-weight: Tokens.typography-weight-medium;
                                horizontal-alignment: Dir.text-start;
                                overflow: elide;
                            }

                            TdnText {
                                text: Account.username;
                                color: Tokens.color-muted-foreground;
                                horizontal-alignment: Dir.text-start;
                                overflow: elide;
                            }
                        }
                    }

                    Rectangle {
                        height: 0.5rem;
                    }

                    SectionTitle {
                        text: Lang.t("page-summary-region", []);
                    }

                    InfoRow {
                        icon: @image-url("../../data/icons/globe-symbolic.svg");
                        label: Lang.t("page-language", []);
                        value: Lang.name(Lang.current_language);
                    }

                    InfoRow {
                        icon: @image-url("../../data/icons/input-keyboard-symbolic.svg");
                        label: Lang.t("page-keyboard", []);
                        value: Lang.current_variant.id == "" ? Lang.current_keymap.name : Lang.current_variant.name;
                    }

                    if Ims.enabled != "": InfoRow {
                        icon: @image-url("../../data/icons/input-keyboard-symbolic.svg");
                        label: Lang.t("page-keyboard-ims", []);
                        value: Ims.enabled;
                    }

                    InfoRow {
                        icon: @image-url("../../data/icons/location-active-symbolic.svg");
                        label: Lang.t("page-timezone", []);
                        value: Lang.t("page-summary-timezone", [
                            { key: "place", value: Lang.place(Tz.current.city, Tz.current.region) },
                            { key: "offset", value: Tz.current.offset },
                        ]);
                    }

                    InfoRow {
                        icon: @image-url("../../data/icons/network-wireless-symbolic.svg");
                        label: Lang.t("page-summary-network", []);
                        value: Network.offline-chosen ? Lang.t("page-summary-network-offline", [])
                            : !Network.online ? Lang.t("page-summary-network-none", [])
                            : Network.connected-ssid != "" ? Network.connected-ssid
                            : Lang.t("page-internet-wired", []);
                    }
                }

                VerticalLayout {
                    layout-order: Dir.order(1);
                    alignment: start;
                    horizontal-stretch: 1;
                    spacing: 0.75rem;

                    SectionTitle {
                        vertical-stretch: 0;
                        text: Lang.t("page-summary-software", []);
                    }

                    Card {
                        vertical-stretch: 0;
                        card-radius: md;

                        VerticalLayout {
                            alignment: start;
                            padding: 0.75rem;

                            spacing: 0.5rem;

                            if Drivers.install: DriverList {
                                offline: !Network.install-online;
                            }

                            for name in Tweaks.enabled-names: DriverRow {
                                icon: @image-url("../../data/icons/systemsettings-symbolic.svg");
                                text: Lang.t(name, []);
                            }

                            if !Drivers.install && Tweaks.enabled-names.length == 0: TdnText {
                                text: Lang.t("page-summary-software-none", []);
                                color: Tokens.color-muted-foreground;
                                horizontal-alignment: Dir.text-start;
                                wrap: word-wrap;
                            }
                        }
                    }

                    if Install.can-download-updates: TdnToggleRow {
                        vertical-stretch: 0;
                        enabled: Network.install-online;
                        text: Lang.t("page-summary-updates", []);
                        checked: Install.download-updates && Network.install-online;
                        toggled(on) => { Install.download-updates = on; }
                    }

                    if Network.proxy-url != "": TdnToggleRow {
                        vertical-stretch: 0;
                        text: Lang.t("page-summary-proxy", [{ key: "proxy", value: Network.proxy-public }]);
                        checked: Network.proxy-persist;
                        toggled(on) => { Network.proxy-persist = on; }
                    }

                    if Tweaks.items.length > 0 && !Cfg.skip-tweaks: HorizontalLayout {
                        vertical-stretch: 0;
                        alignment: Dir.start;

                        TdnBtn {
                            text: Lang.t("page-summary-tweaks", []);
                            icon: @image-url("../../data/icons/move-symbolic.svg");
                            icon-size: 1rem;
                            clicked => { Tweaks.open = true; }
                        }
                    }
                }
            }
        }
    }
}
