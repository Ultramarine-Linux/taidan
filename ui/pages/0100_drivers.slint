import { TdnPage } from "../page.slint";
import { Lang, Dir } from "../lang.slint";
import { Drivers } from "../install.slint";
import { TdnText, TdnToggleRow } from "../components.slint";
import { Card } from "../slintcn/components/card.slint";
import { Tokens } from "../slintcn/theme/tokens.slint";

export component DriverRow inherits HorizontalLayout {
    in property <image> icon;
    in property <string> text;
    // faded, for drivers that won't be installed. Not `opacity`, which renders the row to a layer
    // and shifts the text by a pixel when it toggles.
    in property <bool> dimmed;
    property <color> color: root.dimmed ? Tokens.color-foreground.transparentize(0.5) : Tokens.color-foreground;

    spacing: 0.75rem;
    height: 2.25rem;

    Image {
        source: root.icon;
        colorize: root.color;
        width: 1.5rem;
    }

    TdnText {
        layout-order: Dir.order(1);
        text: root.text;
        color: root.color;
        font-size: 1.1 * Tokens.text-rem;
        horizontal-alignment: Dir.text-start;
        overflow: elide;
    }
}

// what gets installed for the detected hardware, also shown on the summary page
export component DriverList inherits VerticalLayout {
    // dims the optional drivers, the built-in ones are always installed
    property <bool> optional-dimmed: !Drivers.install;

    spacing: 0.5rem;

    DriverRow {
        icon: @image-url("../../data/icons/computer-laptop-symbolic.svg");
        text: Lang.t("page-drivers-builtin", []);
    }

    if Drivers.codecs: DriverRow {
        dimmed: root.optional-dimmed;
        icon: @image-url("../../data/icons/applications-multimedia-symbolic.svg");
        text: Lang.t("page-drivers-codecs", []);
    }

    if Drivers.nvidia: DriverRow {
        dimmed: root.optional-dimmed || Drivers.secure-boot;
        icon: @image-url("../../data/icons/application-x-firmware-symbolic.svg");
        text: Lang.t("page-drivers-nvidia", []);
    }

    if Drivers.broadcom-wifi: DriverRow {
        dimmed: root.optional-dimmed || Drivers.secure-boot;
        icon: @image-url("../../data/icons/network-wireless-symbolic.svg");
        text: Lang.t("page-drivers-broadcom-wifi", []);
    }

    if Drivers.broadcom-bluetooth: DriverRow {
        dimmed: root.optional-dimmed;
        icon: @image-url("../../data/icons/network-wireless-symbolic.svg");
        text: Lang.t("page-drivers-broadcom-bluetooth", []);
    }
}

export component DriversPage inherits TdnPage {
    pageid: "drivers";
    step_i: 2;
    forward-focus: toggle;

    HorizontalLayout {
        spacing: 1rem;

        VerticalLayout {
            alignment: start;
            horizontal-stretch: 100;
            max-width: 21rem;
            spacing: 1.25rem;

            TdnText {
                text: Lang.t("page-drivers-desc", []);
                horizontal-alignment: Dir.text-start;
                wrap: word-wrap;
                font-size: 1.1 * Tokens.text-rem;
            }

            TdnText {
                text: Lang.t("page-drivers-proprietary", []);
                horizontal-alignment: Dir.text-start;
                wrap: word-wrap;
                font-size: 1.1 * Tokens.text-rem;
            }

            toggle := TdnToggleRow {
                // codecs come with the drivers on purpose, and when dnf is skipped there are none
                text: Lang.t(Drivers.codecs ? "page-drivers-install-codecs" : "page-drivers-install", []);
                checked: Drivers.install;
                toggled(on) => { Drivers.install = on; }
                accepted => { root.try-next(); }
            }

            // only when drivers Secure Boot blocks were detected and are wanted
            if Drivers.secure-boot && Drivers.install && (Drivers.nvidia || Drivers.broadcom-wifi): HorizontalLayout {
                spacing: 1rem;

                // dark on light whatever the theme, which scanners read best
                Rectangle {
                    width: 6rem;
                    height: self.width;
                    background: white;
                    border-radius: Tokens.radius-sm;

                    Image {
                        source: Drivers.secure-boot-qr;
                        width: parent.width;
                        height: parent.height;
                        image-rendering: pixelated;
                        accessible-role: image;
                        accessible-label: Drivers.secure-boot-url;
                    }
                }

                VerticalLayout {
                    layout-order: Dir.order(1);
                    alignment: center;
                    spacing: 0.4rem;

                    TdnText {
                        text: Lang.t("page-drivers-secure-boot", []);
                        horizontal-alignment: Dir.text-start;
                        wrap: word-wrap;
                    }

                    TdnText {
                        text: Drivers.secure-boot-url;
                        color: Tokens.color-muted-foreground;
                        horizontal-alignment: Dir.text-start;
                        wrap: word-wrap;
                    }
                }
            }
        }

        // pushes the list to the end edge on wider windows
        Rectangle {
            layout-order: Dir.order(1);
            horizontal-stretch: 1;
        }

        Card {
            layout-order: Dir.order(2);
            horizontal-stretch: 0;
            width: 15rem;
            card-radius: md;

            VerticalLayout {
                alignment: start;
                padding: 0.75rem;

                DriverList { }
            }
        }
    }
}
