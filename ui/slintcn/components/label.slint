import { Tokens } from "../theme/tokens.slint";

export component Label inherits Rectangle {
    in property <string> text;
    in property <bool> required;
    callback clicked();

    preferred-width: row.preferred-width;
    min-width: 0;

    row := HorizontalLayout {
        spacing: 2px;
        Text {
            text: root.text;
            color: Tokens.color-foreground;
            font-size: Tokens.typography-body-size;
            font-weight: Tokens.typography-weight-medium;
            wrap: word-wrap;
            min-width: 0;
        }
        if root.required: Text {
            text: "*";
            color: Tokens.color-destructive;
            font-size: Tokens.typography-body-size;
            font-weight: Tokens.typography-weight-medium;
        }
    }

    TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}
