import { Camera } from "camera.slint";
import { Network } from "network.slint";
import { Tweaks } from "tweaks.slint";
import { A11y } from "a11y.slint";

// whether a dialog is open, and while one is, only controls with `in-dialog` set can take keyboard
// focus, so Tab can't wander to the page underneath
export global Modal {
    out property <bool> open: Camera.open || Network.password-ssid != "" || Network.enterprise-open || Network.offline-prompt || Network.proxy-open || Network.ip-open || Tweaks.open || A11y.open || A11y.more-open;
}
