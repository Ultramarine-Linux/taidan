import { Camera } from "camera.slint";
import { Network } from "network.slint";
import { Tweaks } from "tweaks.slint";
import { A11y } from "a11y.slint";
import { Ims } from "ims.slint";

// whether a dialog is open, and while one is, only controls with `in-dialog` set can take keyboard
// focus, so Tab can't wander to the page underneath. A dialog opened over another one (only "More
// Options" over the accessibility page) has the one underneath give up the keyboard itself, see
// `A11yContent`
export global Modal {
    out property <bool> open: Camera.open || Network.password-ssid != "" || Network.hidden-open || Network.enterprise-open || Network.offline-prompt || Network.proxy-open || Network.ip-open || Tweaks.open || Ims.open || A11y.open || A11y.more-open;
    // the page being shown, kept in sync by `AppWindow`, so an opener only takes the focus back
    // on the page it opened the dialog from
    in-out property <int> page;
    // set by a `DialogOpener` that took the focus back when the dialog closed, otherwise
    // `AppWindow` gives it to the page
    in-out property <bool> returned;
}

// gives the keyboard focus back to the control that opened a dialog once it closes, as Slint drops
// it with the dialog. put one in the control, call `opened()` right after opening the dialog, and
// focus the control in `restore`
export component DialogOpener {
    callback restore();

    // the page the dialog was opened from, -1 unless this opened the current dialog
    property <int> opened-on: -1;
    property <bool> modal-open: Modal.open;

    public function opened() {
        if Modal.open { root.opened-on = Modal.page; }
    }

    changed modal-open => {
        if !root.modal-open && root.opened-on >= 0 {
            // not if the dialog went on to another page, like skipping the network one
            if root.opened-on == Modal.page {
                root.restore();
                Modal.returned = true;
            }
            root.opened-on = -1;
        }
    }

    width: 0;
    height: 0;
}
