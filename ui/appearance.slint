export struct AccentItem {
    id: string,
    color: color,
    fill: color,
    check: color,
}

export global Appearance {
    in property <[AccentItem]> accents;
    in-out property <int> accent: -1;
    in property <bool> plasma;
    in-out property <bool> breeze-dark;
    in-out property <bool> grub-theme: true;
    in-out property <bool> advanced-open;
}
