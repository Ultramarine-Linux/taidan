import { Tokens, Theme, ThemeMode } from "slintcn/theme/tokens.slint";
import { FocusRing } from "slintcn/components/focus-ring.slint";
import { Icon } from "slintcn/components/icon.slint";
import { LucidePaths } from "slintcn/components/lucide-paths.slint";
import { Cfg } from "cfg.slint";
import { Lang, Dir } from "lang.slint";
import { Modal, DialogOpener } from "modal.slint";
import { Appearance } from "appearance.slint";
export { Modal, DialogOpener, Dir }
import { Card } from "slintcn/components/card.slint";
import { ScrollView } from "std-widgets.slint";

export global TdnStyle {
    out property <brush> accent: Appearance.accent >= 0 && Appearance.accent < Appearance.accents.length
        ? Appearance.accents[Appearance.accent].fill
        : Theme.mode == ThemeMode.dark
        ? Cfg.get_brush("accent_color_dark", #4a56e2)
        : Cfg.get_brush("accent_color", #00078f);
    out property <color> accent-foreground: Appearance.accent >= 0 ? white
        : Theme.mode == ThemeMode.dark
        ? Cfg.get_color("accent_foreground_color_dark", Cfg.get_color("accent_foreground_color", white))
        : Cfg.get_color("accent_foreground_color", white);
}

export component TdnText inherits Text {
    horizontal-alignment: center;
    vertical-stretch: 0;
    vertical-alignment: center;
    color: Tokens.color-foreground;
    font-size: Tokens.typography-body-size;
    font-weight: 400;
}

export component TdnPara inherits TdnText {
    horizontal-alignment: Dir.text-start;
    wrap: word-wrap;
}

export component TdnNote inherits TdnPara {
    color: Tokens.color-muted-foreground;
}

export component TdnPressable inherits Rectangle {
    in property <bool> enabled: true;
    in property <bool> busy;
    in property <bool> focusable: root.enabled;
    in property <bool> tab-focusable: true;
    in property <bool> in-dialog;
    in property <bool> opens-dialog;
    in property <bool> click-focuses;
    in property <bool> ring-inset;
    in property <length> ring-offset: Tokens.focus-ring-offset;
    in property <length> ring-radius: Tokens.radius-md + self.ring-offset;
    in-out property <bool> pointer-focus;
    out property <bool> has-focus: focus.has-focus;
    out property <bool> has-hover: area.has-hover;
    out property <bool> pressed: area.pressed;
    out property <bool> active: root.enabled && !root.busy;
    callback activated;
    callback key(KeyEvent) -> EventResult;
    key(event) => { reject }
    callback blurred(FocusReason);

    function press() {
        root.activated();
        if root.opens-dialog && !root.in-dialog { opener.opened(); }
    }

    forward-focus: focus;
    accessible-enabled: root.active;
    accessible-action-default => {
        if root.active && Modal.open == root.in-dialog { root.press(); }
    }

    @children

    focus := FocusScope {
        enabled: root.focusable && Modal.open == root.in-dialog;
        focus-on-tab-navigation: root.tab-focusable;
        focus-gained(reason) => {
            if reason == FocusReason.tab-navigation { root.pointer-focus = false; }
        }
        focus-lost(reason) => { root.blurred(reason); }
        key-pressed(event) => {
            root.pointer-focus = false;
            if root.key(event) == EventResult.accept { return accept; }
            if event.text == Key.Return || event.text == " " {
                if !event.repeat && root.active { root.press(); }
                return accept;
            }
            reject
        }
    }

    opener := DialogOpener {
        restore => { focus.focus(); }
    }

    area := TouchArea {
        enabled: root.active || (root.focusable && !root.busy);
        mouse-cursor: root.active ? pointer : default;
        pointer-event(ev) => {
            if ev.kind == PointerEventKind.down { root.pointer-focus = true; }
        }
        clicked => {
            if !root.active { return; }
            root.press();
            if root.click-focuses { focus.focus(); }
        }
    }

    if focus.has-focus && !root.pointer-focus: FocusRing {
        host-width: parent.width;
        host-height: parent.height;
        inset: root.ring-inset;
        offset: root.ring-offset;
        radius: root.ring-radius;
    }
}

export component TdnTile inherits TdnPressable {
    in property <bool> checked;
    in property <length> badge-inset: 0.5rem;

    accessible-checkable: true;
    accessible-checked: root.checked;

    border-radius: Tokens.radius-lg;
    border-width: root.checked ? 2px : 1px;
    border-color: root.checked ? TdnStyle.accent : Tokens.color-border-hairline;
    background: Tokens.color-card;
    animate border-color { duration: Tokens.motion-fast; }

    // animating the opaque background to a translucent tint would dip through the page color
    Rectangle {
        border-radius: root.border-radius;
        background: TdnStyle.accent;
        opacity: root.checked ? 0.15 : 0;
        animate opacity { duration: Tokens.motion-fast; }
    }

    Rectangle {
        border-radius: root.border-radius;
        background: Tokens.color-foreground;
        opacity: root.pressed ? 0.1 : root.has-hover ? 0.05 : 0;
        animate opacity { duration: Tokens.motion-fast; easing: ease-out; }
    }

    @children

    if root.checked: Rectangle {
        x: Dir.x(parent.width - self.width - root.badge-inset, self.width, parent.width);
        y: root.badge-inset;
        width: 1.4rem;
        height: self.width;
        border-radius: self.width / 2;
        background: TdnStyle.accent;

        Icon {
            commands: LucidePaths.check;
            size: parent.width * 0.65;
            tint: TdnStyle.accent-foreground;
            stroke-width: 3px;
        }
    }
}

export component TdnBtn inherits TdnPressable {
    in property <string> text;
    in property <image> icon;
    in property <bool> primary;
    in property <brush> background-color: root.primary ? TdnStyle.accent : Tokens.color-primary;
    in property <color> foreground-color: root.primary ? TdnStyle.accent-foreground
        : root.outline ? Tokens.color-foreground
        : Tokens.color-primary-foreground;
    in property <length> font-size: Tokens.typography-body-size;
    in property <length> padding-x: 1rem;
    in property <length> icon-size: 1.25rem;
    in property <length> min-size: 2.25rem;
    in property <bool> enter-hint: root.primary;
    in property <bool> outline;
    callback clicked;

    opens-dialog: true;
    activated => { root.clicked(); }
    accessible-role: button;
    accessible-label: root.text;

    min-height: root.min-size * Tokens.text-scale;
    min-width: root.min-size * Tokens.text-scale;
    border-radius: Tokens.radius-md;

    // Slint inlines a full copy of a component with `opacity` or an animated `background` on its
    // root at every use
    Rectangle {
        border-radius: root.border-radius;
        border-width: root.outline ? 1px : 0;
        border-color: Tokens.color-border-hairline-strong;
        opacity: root.outline && !root.enabled ? 0.5 : 1;
        background: root.outline ? (root.has-hover ? Tokens.color-accent : transparent)
            : !root.enabled ? root.background-color.transparentize(0.6)
            : root.pressed ? root.background-color.transparentize(0.2)
            : root.has-hover ? root.background-color.transparentize(0.1)
            : root.background-color;
        animate background { duration: Tokens.motion-fast; }

        HorizontalLayout {
            padding-left: root.padding-x * Tokens.text-scale;
            padding-right: self.padding-left;
            spacing: 0.5rem;
            alignment: center;

            if root.icon.width > 0: Image {
                source: root.icon;
                colorize: root.foreground-color;
                width: root.icon-size * Tokens.text-scale;
            }

            if root.text != "": TdnText {
                layout-order: Dir.order(1);
                text: root.text;
                min-width: 0;
                overflow: elide;
                color: root.enabled ? root.foreground-color : root.foreground-color.transparentize(0.3);
                font-size: root.font-size;
                font-weight: Tokens.typography-weight-medium;
            }

            if root.enter-hint: VerticalLayout {
                layout-order: Dir.order(2);
                alignment: center;
                Rectangle {
                    width: root.font-size * 1.5;
                    height: root.font-size * 1.35;
                    border-radius: Tokens.radius-sm;
                    background: root.foreground-color.transparentize(0.75);
                    opacity: root.enabled ? 1 : 0.6;
                    Icon {
                        commands: LucidePaths.enter-key;
                        size: parent.height * 0.75;
                        tint: root.foreground-color;
                    }
                }
            }
        }
    }
}

export component TdnInput inherits Rectangle {
    in-out property <string> text;
    in property <string> placeholder;
    in property <string> label;
    in property <string> description;
    in property <bool> enabled: true;
    in property <bool> password;
    in property <bool> auto-focus;
    in property <image> icon;
    in property <bool> in-dialog;
    in property <bool> invalid;
    callback edited(string);
    callback accepted(string);
    callback key-pressed(KeyEvent) -> EventResult;
    key-pressed(event) => { reject }
    public function select-all() { input.select-all(); }

    property <bool> revealed;
    in property <bool> page-active: true;
    changed page-active => { if !self.page-active { root.revealed = false; } }
    property <bool> has-icon: root.icon.width > 0;

    // the focused `TextInput` has no accessible role, so screen readers read this wrapper like the
    // std-widgets `LineEdit`
    forward-focus: input;
    accessible-role: text-input;
    accessible-label: root.label != "" ? root.label : root.placeholder;
    accessible-description: root.description;
    accessible-placeholder-text: root.label != "" ? root.placeholder : "";
    accessible-value: root.password ? "" : root.text;
    accessible-enabled: root.enabled;
    accessible-action-set-value(v) => {
        if root.enabled && Modal.open == root.in-dialog {
            root.text = v;
            root.edited(v);
        }
    }

    height: Tokens.density-input;
    border-radius: Tokens.radius-md;

    frame := Rectangle {
        background: Theme.mode == ThemeMode.light ? #ffffff : Tokens.color-surface-1;
        border-color: root.invalid ? Tokens.color-destructive
            : input.has-focus ? Tokens.color-ring
            : Tokens.color-border-hairline;
        border-width: 1px;
        border-radius: root.border-radius;
        opacity: root.enabled ? 1.0 : 0.5;

        TouchArea {
            mouse-cursor: MouseCursor.text;
            clicked => { input.focus(); }
        }

        icon := Image {
            visible: root.has-icon;
            source: root.icon;
            x: Dir.x(10 * Tokens.unit, self.width, parent.width);
            width: root.has-icon ? 1.1rem : 0;
            height: self.width;
            y: (parent.height - self.height) / 2;
            colorize: Tokens.color-muted-foreground;
            accessible-role: none;
        }

        input := TextInput {
            property <length> offset: root.has-icon ? 10 * Tokens.unit + icon.width + 8 * Tokens.unit : 12 * Tokens.unit;
            x: Dir.x(self.offset, self.width, parent.width);
            y: 0;
            width: (reveal.visible ? parent.width - reveal.width - 4 * Tokens.unit : parent.width - 12 * Tokens.unit) - self.offset;
            horizontal-alignment: Dir.text-start;
            height: parent.height;
            text <=> root.text;
            color: Tokens.color-foreground;
            selection-background-color: TdnStyle.accent.transparentize(0.6);
            font-size: Tokens.typography-body-size;
            single-line: true;
            read-only: !root.enabled;
            enabled: root.enabled && Modal.open == root.in-dialog;
            input-type: root.password && !root.revealed ? InputType.password : InputType.text;
            vertical-alignment: center;
            accessible-role: none;
            edited => { root.edited(self.text); }
            accepted => { root.accepted(self.text); }
            key-pressed(event) => {
                if event.text == Key.Return && event.repeat { return accept; }
                root.key-pressed(event)
            }
            init => { if root.auto-focus { self.focus(); } }
        }

        if root.text == "" && input.preedit-text == "": Text {
            x: input.x;
            y: 0;
            width: input.width;
            height: parent.height;
            text: root.placeholder;
            horizontal-alignment: Dir.text-start;
            color: Tokens.color-muted-foreground;
            font-size: Tokens.typography-body-size;
            vertical-alignment: center;
            overflow: elide;
            accessible-role: none;
        }

        reveal := TdnPressable {
            visible: root.password;
            width: root.password ? parent.height : 0;
            height: parent.height;
            x: Dir.x(parent.width - self.width, self.width, parent.width);
            border-radius: Tokens.radius-md;
            enabled: root.enabled;
            focusable: root.password && root.enabled;
            in-dialog: root.in-dialog;
            ring-inset: true;
            ring-offset: 3px;
            ring-radius: Tokens.radius-sm;
            activated => { root.revealed = !root.revealed; }
            accessible-role: button;
            accessible-label: Lang.t("page-password-show", []);
            accessible-checkable: true;
            accessible-checked: root.revealed;

            Image {
                source: @image-url("../data/icons/eye-open-negative-filled-symbolic.svg");
                width: 1.1rem;
                height: self.width;
                colorize: root.revealed ? Tokens.color-foreground : Tokens.color-muted-foreground;
                accessible-role: none;
            }
        }

        if input.has-focus: FocusRing {
            host-width: parent.width;
            host-height: parent.height;
        }
    }
}

export component TdnListRow inherits TdnPressable {
    in property <string> text;
    in property <string> secondary;
    in property <bool> selected;
    in property <bool> highlighted;
    callback clicked;

    focusable: false;
    activated => { root.clicked(); }
    accessible-role: list-item;
    accessible-label: root.secondary == "" ? root.text : root.text + ", " + root.secondary;
    accessible-item-selectable: true;
    accessible-item-selected: root.selected;
    ring-inset: true;
    ring-offset: 0;
    ring-radius: Tokens.radius-sm;

    height: 2.25rem;
    border-radius: Tokens.radius-sm;
    background: root.selected ? TdnStyle.accent
        : root.has-hover || root.highlighted ? Tokens.color-accent
        : transparent;

    HorizontalLayout {
        padding-left: 0.75rem;
        padding-right: 0.75rem;
        spacing: 1rem;

        TdnText {
            text: root.text;
            horizontal-alignment: Dir.text-start;
            min-width: 0;
            overflow: elide;
            color: root.selected ? TdnStyle.accent-foreground : Tokens.color-foreground;
            accessible-role: none;
        }

        if root.secondary != "": TdnText {
            layout-order: Dir.order(1);
            text: root.secondary;
            horizontal-alignment: Dir.text-end;
            horizontal-stretch: 0;
            color: root.selected ? TdnStyle.accent-foreground : Tokens.color-muted-foreground;
            accessible-role: none;
        }
    }
}

export component TdnSelect inherits Rectangle {
    in property <[string]> options;
    in-out property <int> index;
    in property <bool> enabled: true;
    in property <bool> in-dialog;
    in property <string> label;
    callback changed(int);
    callback focus-in(y: length, height: length);

    property <bool> open;
    property <bool> has-focus: header.has-focus;

    changed has-focus => {
        if self.has-focus { root.focus-in(root.absolute-position.y, root.height); }
    }
    changed open => {
        if self.open { root.focus-in(root.absolute-position.y, root.height); }
    }

    function toggle() {
        if root.enabled && Modal.open == root.in-dialog { root.open = !root.open; }
    }

    function pick(i: int) {
        if i >= 0 && i < root.options.length && i != root.index {
            root.index = i;
            root.changed(i);
        }
    }

    forward-focus: header;
    accessible-role: combobox;
    accessible-label: root.label;
    accessible-value: root.options[root.index];
    accessible-enabled: root.enabled;
    accessible-expandable: true;
    accessible-expanded: root.open;
    accessible-action-default => { root.toggle(); }
    accessible-action-expand => { root.toggle(); }

    VerticalLayout {
        spacing: 0.25rem;

        header := TdnPressable {
            enabled: root.enabled;
            in-dialog: root.in-dialog;
            click-focuses: true;
            accessible-role: none;
            activated => { root.open = !root.open; }
            key(event) => {
                if event.text == Key.DownArrow { root.pick(root.index + 1); return accept; }
                if event.text == Key.UpArrow { root.pick(root.index - 1); return accept; }
                if event.text == Key.Home { root.pick(0); return accept; }
                if event.text == Key.End { root.pick(root.options.length - 1); return accept; }
                if event.text == Key.Escape && root.open {
                    root.open = false;
                    return accept;
                }
                reject
            }
            blurred(reason) => {
                if reason == FocusReason.tab-navigation || reason == FocusReason.pointer-click {
                    root.open = false;
                }
            }

            height: Tokens.density-input;
            border-radius: Tokens.radius-md;
            border-width: 1px;
            border-color: Tokens.color-border-hairline-strong;
            background: self.has-hover && root.enabled ? Tokens.color-accent : Tokens.color-card;
            opacity: root.enabled ? 1 : 0.5;

            HorizontalLayout {
                padding-left: 0.75rem;
                padding-right: 0.6rem;
                spacing: 0.5rem;

                TdnText {
                    text: root.options[root.index];
                    horizontal-stretch: 1;
                    min-width: 0;
                    horizontal-alignment: Dir.text-start;
                    overflow: elide;
                }

                VerticalLayout {
                    layout-order: Dir.order(1);
                    alignment: center;
                    horizontal-stretch: 0;

                    Icon {
                        commands: root.open ? LucidePaths.chevron-up : LucidePaths.chevron-down;
                        size: 1rem;
                        tint: Tokens.color-muted-foreground;
                    }
                }
            }
        }

        if root.open && root.enabled: Rectangle {
            border-radius: Tokens.radius-md;
            border-width: 1px;
            border-color: Tokens.color-border-hairline-strong;
            background: Tokens.color-card;

            VerticalLayout {
                padding: 0.25rem;

                for option[i] in root.options: TdnListRow {
                    in-dialog: root.in-dialog;
                    text: option;
                    selected: i == root.index;
                    clicked => {
                        root.pick(i);
                        root.open = false;
                    }
                }
            }
        }
    }
}

export component TdnField inherits VerticalLayout {
    in property <string> label;
    in property <string> help;
    in property <string> error;
    out property <string> description: root.error != "" ? root.error : root.help;
    callback label-clicked;

    spacing: 0.4rem;

    HorizontalLayout {
        alignment: Dir.start;

        Rectangle {
            preferred-width: label-row.preferred-width;
            min-width: 0;

            label-row := HorizontalLayout {
                Text {
                    text: root.label;
                    color: Tokens.color-foreground;
                    font-size: Tokens.typography-body-size;
                    font-weight: Tokens.typography-weight-medium;
                    wrap: word-wrap;
                    min-width: 0;
                }
            }

            TouchArea {
                mouse-cursor: pointer;
                clicked => { root.label-clicked(); }
            }
        }
    }

    @children

    if root.description != "": TdnNote {
        text: root.description;
        color: root.error != "" ? Tokens.color-destructive : Tokens.color-muted-foreground;
        font-size: Tokens.typography-body-sm-size;
    }
}

export component TdnTextField inherits TdnField {
    in-out property <string> text;
    in property <string> placeholder;
    in property <string> input-description: root.description;
    in property <bool> password;
    in property <bool> invalid: root.error != "";
    in property <bool> enabled: true;
    in property <bool> in-dialog;
    in property <bool> auto-focus;
    in property <bool> page-active: true;
    callback edited(string);
    callback accepted(string);
    public function select-all() { input.select-all(); }

    forward-focus: input;
    label-clicked => { input.focus(); }

    input := TdnInput {
        label: root.label;
        description: root.input-description;
        placeholder: root.placeholder;
        text <=> root.text;
        password: root.password;
        invalid: root.invalid;
        enabled: root.enabled;
        in-dialog: root.in-dialog;
        auto-focus: root.auto-focus;
        page-active: root.page-active;
        edited(text) => { root.edited(text); }
        accepted(text) => { root.accepted(text); }
    }
}

export component TdnToggleRow inherits TdnPressable {
    in property <string> text;
    in property <bool> checked;
    callback toggled(bool);
    callback accepted();
    callback focus-in(y: length, height: length);

    changed has-focus => {
        if self.has-focus { root.focus-in(root.absolute-position.y, root.height); }
    }

    property <float> disabled-fade: root.enabled ? 0 : 0.5;

    focusable: true;
    activated => { root.toggled(!root.checked); }
    key(event) => {
        if event.text != Key.Return { return reject; }
        if !event.repeat { root.accepted(); }
        accept
    }
    accessible-role: switch;
    accessible-label: root.text;
    accessible-checkable: true;
    accessible-checked: root.checked;
    ring-radius: Tokens.radius-lg + self.ring-offset;

    min-height: 3rem;
    border-radius: Tokens.radius-lg;
    border-width: 1px;
    border-color: Tokens.color-border-hairline-strong;
    background: Tokens.color-card;

    HorizontalLayout {
        padding-left: 0.85rem;
        padding-right: 0.85rem;
        padding-top: 0.4rem;
        padding-bottom: 0.4rem;
        spacing: 1rem;

        TdnPara {
            text: root.text;
            color: Tokens.color-foreground.transparentize(root.disabled-fade);
            font-weight: Tokens.typography-weight-medium;
            min-width: 0;
        }

        VerticalLayout {
            layout-order: Dir.order(1);
            alignment: center;

            Rectangle {
                width: 2.4rem;
                height: 1.3rem;
                border-radius: self.height / 2;
                border-width: 1px;
                border-color: (root.checked ? Tokens.color-primary : Tokens.color-muted-foreground).transparentize(root.disabled-fade);
                background: root.checked ? Tokens.color-primary.transparentize(root.disabled-fade) : transparent;
                animate background, border-color { duration: Tokens.motion-fast; }

                Rectangle {
                    width: parent.height - 0.3rem;
                    height: self.width;
                    y: 0.15rem;
                    x: Dir.x(root.checked ? parent.width - self.width - 0.15rem : 0.15rem, self.width, parent.width);
                    border-radius: self.width / 2;
                    background: root.checked ? Tokens.color-primary-foreground : Tokens.color-muted-foreground.transparentize(root.disabled-fade);
                    animate background { duration: Tokens.motion-fast; }
                    animate x {
                        duration: Tokens.motion-fast;
                        easing: Tokens.motion-easing-standard;
                    }
                }
            }
        }
    }
}

export component TdnSpinner inherits Rectangle {
    property <color> tint: Tokens.color-foreground;
    property <length> stroke: 2.5 * Tokens.unit;

    property <angle> start: Tokens.reduce-motion ? -90deg : mod(animation-tick() / 1ms * 0.36deg, 360deg);
    property <length> r: (min(self.width, self.height) - self.stroke) / 2;

    width: 1.5rem;
    height: self.width;
    accessible-role: progress-indicator;

    Path {
        width: 100%;
        height: 100%;
        viewbox-x: 0;
        viewbox-y: 0;
        viewbox-width: root.width / 1px;
        viewbox-height: root.height / 1px;
        stroke: root.tint;
        stroke-width: root.stroke;
        stroke-line-cap: round;

        MoveTo {
            x: (root.width / 2 + root.r * cos(root.start)) / 1px;
            y: (root.height / 2 + root.r * sin(root.start)) / 1px;
        }

        ArcTo {
            x: (root.width / 2 + root.r * cos(root.start + 270deg)) / 1px;
            y: (root.height / 2 + root.r * sin(root.start + 270deg)) / 1px;
            radius-x: root.r / 1px;
            radius-y: root.r / 1px;
            large-arc: true;
            sweep: true;
        }
    }
}

export component TdnDialog inherits Rectangle {
    in property <string> title;
    in property <string> description;
    in property <string> done-text;
    in property <length> dialog-width: 22rem;
    callback dismissed;

    width: 100%;
    height: 100%;
    background: #00000099;

    TouchArea { }

    FocusScope {
        focus-on-tab-navigation: false;
        focus-on-click: false;
        key-pressed(event) => {
            if event.text == Key.Escape {
                root.dismissed();
                return accept;
            }
            reject
        }

        Card {
            x: (root.width - self.width) / 2;
            y: (root.height - self.height) / 2;
            width: min(root.dialog-width, root.width - 2rem);
            height: min(content.preferred-height, root.height - 2rem);
            background: Tokens.color-background;
            card-radius: lg;

            content := VerticalLayout {
                padding: 1.25rem;
                spacing: 1rem;
                // Slint has no dialog role
                accessible-role: groupbox;
                accessible-label: root.title;

                TdnPara {
                    text: root.title;
                    font-size: 1.4 * Tokens.text-rem;
                    font-weight: 500;
                }

                if root.description != "": TdnNote {
                    text: root.description;
                }

                @children

                if root.done-text != "": HorizontalLayout {
                    alignment: Dir.end;

                    TdnBtn {
                        in-dialog: true;
                        primary: true;
                        text: root.done-text;
                        clicked => { root.dismissed(); }
                        init => { self.focus(); }
                    }
                }
            }
        }
    }
}

export component TdnScrollList inherits ScrollView {
    in property <length> spacing: 1rem;

    public function reveal(y: length, item-height: length) {
        let ring = Tokens.focus-ring-offset + Tokens.focus-ring-width;
        let height = item-height + 2 * ring;
        let top = y - ring - root.absolute-position.y;
        if top < 0 {
            root.content-y = min(0, root.content-y - top);
        } else if top + height > root.visible-height {
            root.content-y = max(
                root.visible-height - root.content-height,
                root.content-y - (top + height - root.visible-height));
        }
    }

    // `list.preferred-height` measures wrapped text as a single line
    preferred-height: list-end.y;
    content-width: self.visible-width;
    content-height: list-end.y;
    horizontal-scrollbar-policy: always-off;

    list := VerticalLayout {
        width: root.visible-width;
        height: self.preferred-height;
        alignment: start;
        spacing: root.spacing;
        padding-left: Tokens.focus-ring-offset + Tokens.focus-ring-width;
        padding-top: self.padding-left;
        padding-right: 0.9rem;

        @children

        list-end := Rectangle { height: 0; }
    }
}

export component TdnDialogActions inherits HorizontalLayout {
    in property <string> cancel-text: Lang.t("cancel", []);
    in property <string> submit-text;
    in property <bool> submit-enabled: true;
    in property <bool> busy;
    out property <bool> cancel-has-focus: cancel-btn.has-focus;
    callback cancelled;
    callback submitted;
    public function focus-cancel() { cancel-btn.focus(); }
    public function focus-submit() { submit-btn.focus(); }

    alignment: space-between;

    HorizontalLayout {
        spacing: 0.5rem;

        cancel-btn := TdnBtn {
            in-dialog: true;
            text: root.cancel-text;
            clicked => { root.cancelled(); }
        }

        @children
    }

    HorizontalLayout {
        layout-order: Dir.order(1);
        spacing: 0.75rem;

        if root.busy: VerticalLayout {
            alignment: center;
            TdnSpinner { width: 1.1rem; }
        }

        submit-btn := TdnBtn {
            layout-order: Dir.order(1);
            in-dialog: true;
            primary: true;
            text: root.submit-text;
            enabled: root.submit-enabled;
            clicked => { root.submitted(); }
        }
    }
}

export component TdnSearchInput inherits TdnInput {
    in property <bool> navigable: true;
    callback move(rows: int);

    icon: @image-url("../data/icons/system-search-symbolic.svg");
    key-pressed(event) => {
        if !root.navigable { return reject; }
        if event.text == Key.DownArrow { root.move(1); return accept; }
        if event.text == Key.UpArrow { root.move(-1); return accept; }
        if event.text == Key.PageDown { root.move(10); return accept; }
        if event.text == Key.PageUp { root.move(-10); return accept; }
        reject
    }
}

export global TdnScroll {
    public pure function content-y-showing(row: int, row-height: length, content-y: length, visible-height: length) -> length {
        let top = row * row-height;
        if top < -content-y {
            return -top;
        }
        if top + row-height > -content-y + visible-height {
            return visible-height - top - row-height;
        }
        content-y
    }
}

// `ListView` only creates the rows in view, so this tracks which model row is current
export component TdnCurrentRow {
    in property <int> model-row;
    in property <bool> current;
    in-out property <int> current-row;

    width: 0;
    height: 0;
    init => { if root.current { root.current-row = root.model-row; } }
    changed current => {
        if root.current { root.current-row = root.model-row; }
        else if root.current-row == root.model-row { root.current-row = -1; }
    }
}

export component TdnOptionRow inherits VerticalLayout {
    in property <string> text;
    in property <string> description;
    in property <bool> checked;
    in property <bool> enabled: true;
    callback toggled(bool);
    callback accepted();
    callback focus-in(y: length, height: length);

    spacing: 0.4rem;

    TdnToggleRow {
        in-dialog: true;
        text: root.text;
        enabled: root.enabled;
        checked: root.checked;
        toggled(on) => { root.toggled(on); }
        accepted => { root.accepted(); }
        focus-in(y, height) => { root.focus-in(y, height); }
    }

    TdnNote {
        text: root.description;
        font-size: Tokens.typography-body-sm-size;
    }
}

export component TdnFormColumn inherits HorizontalLayout {
    in property <length> column-width: 23rem;
    in property <length> column-padding-top: 1rem;
    in property <length> column-spacing: 2rem;

    spacing: 1rem;

    VerticalLayout {
        alignment: start;
        horizontal-stretch: 100;
        max-width: root.column-width;
        padding-top: root.column-padding-top;
        spacing: root.column-spacing;

        @children
    }

    Rectangle {
        layout-order: Dir.order(1);
        horizontal-stretch: 1;
    }
}

export component TdnSideCard inherits VerticalLayout {
    in property <length> content-padding: 0.6rem;
    in property <length> content-spacing: 0.75rem;
    in property <bool> fill-height;

    layout-order: Dir.order(1);
    alignment: root.fill-height ? LayoutAlignment.stretch : LayoutAlignment.start;
    horizontal-stretch: 0;

    Card {
        card-radius: md;

        VerticalLayout {
            alignment: start;
            padding: root.content-padding;
            spacing: root.content-spacing;

            @children
        }
    }
}
