import { Tokens, Theme, ThemeMode } from "slintcn/theme/tokens.slint";
import { FocusRing } from "slintcn/components/focus-ring.slint";
import { Label, LabelVariant } from "slintcn/components/label.slint";
import { Icon } from "slintcn/components/icon.slint";
import { LucidePaths } from "slintcn/components/lucide-paths.slint";
import { Cfg } from "cfg.slint";
import { Lang, Dir } from "lang.slint";
import { Modal, DialogOpener } from "modal.slint";
import { Appearance } from "appearance.slint";
export { Modal, DialogOpener, Dir }
import { Card } from "slintcn/components/card.slint";

export global TdnStyle {
    // the accent picked on the theme page, so it shows right away like dark mode does, otherwise
    // the distro's, lightened in dark mode so it still reads on a dark background
    out property <brush> accent: Appearance.accent >= 0 && Appearance.accent < Appearance.accents.length
        ? Appearance.accents[Appearance.accent].fill
        : Theme.mode == ThemeMode.dark
        ? Cfg.get_brush("accent_color_dark", #4a56e2)
        : Cfg.get_brush("accent_color", #00078f);
    // text and icons on the accent, for distros with a light one. The picked accents all take
    // white, as in libadwaita, which their fills are darkened for
    out property <color> accent-foreground: Appearance.accent >= 0 ? white
        : Theme.mode == ThemeMode.dark
        ? Cfg.get_color("accent_foreground_color_dark", Cfg.get_color("accent_foreground_color", white))
        : Cfg.get_color("accent_foreground_color", white);
}

export component TdnText inherits Text {
    horizontal-alignment: center;
    vertical-stretch: 0;
    vertical-alignment: center;
    color: Tokens.color-foreground;
    font-size: Tokens.typography-body-size;
    font-weight: 400;
}

// button sized by its own content, focusable with Tab and activated by Enter/Space
export component TdnBtn inherits Rectangle {
    in property <string> text;
    in property <image> icon;
    in property <brush> background-color: Tokens.color-primary;
    // outline buttons have no fill, so their text is the page's
    in property <color> foreground-color: root.outline ? Tokens.color-foreground : Tokens.color-primary-foreground;
    in property <length> font-size: Tokens.typography-body-size;
    in property <bool> enabled: true;
    // horizontal space between the edge and the content
    in property <length> padding-x: 1rem;
    in property <length> icon-size: 1.25rem;
    in property <length> min-size: 2.25rem;
    // shows a ⏎ key after the text, for buttons that Enter activates
    in property <bool> enter-hint;
    // a bordered button with no fill, for secondary actions in lists
    in property <bool> outline;
    // whether this is part of a dialog, see `Modal`
    in property <bool> in-dialog;
    callback clicked;
    out property <bool> has-hover: area.has-hover;
    out property <bool> pressed: area.pressed;
    out property <bool> has-focus: focus.has-focus;

    property <bool> pointer-focus;

    // presses it, and if that opened a dialog, the focus comes back here once it closes
    function press() {
        root.clicked();
        if !root.in-dialog { opener.opened(); }
    }

    forward-focus: focus;
    accessible-role: button;
    accessible-label: root.text;
    accessible-enabled: root.enabled;
    accessible-action-default => {
        if root.enabled && Modal.open == root.in-dialog { root.press(); }
    }

    // sizes are given in layout units, but buttons are drawn at text size, see `Tokens.text-scale`
    min-height: root.min-size * Tokens.text-scale;
    min-width: root.min-size * Tokens.text-scale;
    border-radius: Tokens.radius-md;

    // the fill, border and dimming are on this inner rectangle, not the root. Slint inlines
    // every instance of a component with `opacity` or an animated `background` on its root,
    // a copy of the whole button per use
    frame := Rectangle {
        border-radius: root.border-radius;
        border-width: root.outline ? 1px : 0;
        border-color: Tokens.color-border-hairline-strong;
        opacity: root.outline && !root.enabled ? 0.5 : 1;
        background: root.outline ? (area.has-hover ? Tokens.color-accent : transparent)
            : !root.enabled ? root.background-color.transparentize(0.6)
            : area.pressed ? root.background-color.transparentize(0.2)
            : area.has-hover ? root.background-color.transparentize(0.1)
            : root.background-color;
        animate background { duration: Tokens.motion-fast; }

        focus := FocusScope {
            enabled: root.enabled && Modal.open == root.in-dialog;
            // a click set it, so it can be stale when Tab comes back here from elsewhere
            focus-gained(reason) => {
                if reason == FocusReason.tab-navigation { root.pointer-focus = false; }
            }
            key-pressed(event) => {
                root.pointer-focus = false;
                // a held key repeats, which would go on to press whatever gets the focus next, like
                // Confirm on the summary
                if event.text == Key.Return || event.text == " " {
                    if !event.repeat { root.press(); }
                    return accept;
                }
                reject
            }
        }

        opener := DialogOpener {
            restore => { focus.focus(); }
        }

        HorizontalLayout {
            padding-left: root.padding-x * Tokens.text-scale;
            padding-right: self.padding-left;
            spacing: 0.5rem;
            alignment: center;

            if root.icon.width > 0: Image {
                source: root.icon;
                colorize: root.foreground-color;
                width: root.icon-size * Tokens.text-scale;
            }

            if root.text != "": TdnText {
                layout-order: Dir.order(1);
                text: root.text;
                // or a layout never shrinks it below its full width, and it can't elide
                min-width: 0;
                overflow: elide;
                color: root.enabled ? root.foreground-color : root.foreground-color.transparentize(0.3);
                font-size: root.font-size;
                font-weight: Tokens.typography-weight-medium;
            }

            if root.enter-hint: VerticalLayout {
                layout-order: Dir.order(2);
                alignment: center;
                // a soft keycap, tinted from the text color so it works on any button color
                Rectangle {
                    width: root.font-size * 1.5;
                    height: root.font-size * 1.35;
                    border-radius: Tokens.radius-sm;
                    background: root.foreground-color.transparentize(0.75);
                    opacity: root.enabled ? 1 : 0.6;
                    Icon {
                        commands: LucidePaths.enter-key;
                        size: parent.height * 0.75;
                        tint: root.foreground-color;
                        stroke-width: 2px;
                    }
                }
            }
        }

        // above the FocusScope, so a click doesn't move focus to the button
        area := TouchArea {
            enabled: root.enabled;
            mouse-cursor: root.enabled ? pointer : default;
            pointer-event(ev) => {
                if ev.kind == PointerEventKind.down { root.pointer-focus = true; }
            }
            clicked => { root.press(); }
        }

        if focus.has-focus && !root.pointer-focus: FocusRing {
            host-width: parent.width;
            host-height: parent.height;
        }
    }
}

// from slintcn Input
export component TdnInput inherits Rectangle {
    // two-way bound to the field contents
    in-out property <string> text;
    // hint shown when the field is empty
    in property <string> placeholder;
    // accessible name, usually the visible label of the `TdnField` around it, falls back to
    // the placeholder
    in property <string> label;
    // read by screen readers after the name, usually the field's help or error text
    in property <string> description;
    // when false, the input dims and stops accepting keystrokes
    in property <bool> enabled: true;
    // when true, the user can focus but not edit
    in property <bool> read-only: false;
    // when true, characters render as bullets
    in property <bool> password: false;
    // when true, the input grabs focus on mount
    in property <bool> auto-focus: false;
    // leading icon, e.g. a magnifier for search fields
    in property <image> icon;
    // accessible name of the show/hide toggle on password fields
    in property <string> reveal-label: Lang.t("page-password-show", []);
    // whether this is part of a dialog, see `Modal`
    in property <bool> in-dialog;
    // draws the border in the destructive color
    in property <bool> invalid: false;
    // fired on every keystroke with the current text
    callback edited(string);
    // fired on Enter with the current text
    callback accepted(string);
    // keys the text field doesn't handle itself (e.g. arrow keys to move through a list)
    callback key-pressed(KeyEvent) -> EventResult;
    key-pressed(event) => { reject }
    public function select-all() { input.select-all(); }

    // true while focus arrived from a pointer press — suppresses the ring so it
    // is keyboard-only (focus-visible emulation), set on pointer down, cleared
    // on any key interaction
    property <bool> pointer-focus: false;
    property <bool> revealed: false;
    property <bool> reveal-pointer-focus: false;
    // the page it's on is shown, leaving it hides a revealed password again
    in property <bool> page-active: true;
    changed page-active => { if !self.page-active { root.revealed = false; } }
    property <bool> has-icon: root.icon.width > 0;

    // the focused `TextInput` has no accessible role of its own, so screen readers land on
    // this element and read the label from here, like the std-widgets `LineEdit`
    forward-focus: input;
    accessible-role: text-input;
    accessible-label: root.label != "" ? root.label : root.placeholder;
    accessible-description: root.description;
    accessible-placeholder-text: root.label != "" ? root.placeholder : "";
    accessible-value: root.password ? "" : root.text;
    accessible-enabled: root.enabled;
    accessible-read-only: root.read-only;
    accessible-action-set-value(v) => {
        if root.enabled && !root.read-only && Modal.open == root.in-dialog {
            root.text = v;
            root.edited(v);
        }
    }

    height: Tokens.density-input;
    border-radius: Tokens.radius-md;

    // the fill, border and dimming are on this inner rectangle, not the root. Slint inlines
    // every instance of a component with `opacity` on its root, a copy of the whole input
    // per use
    frame := Rectangle {
        background: Theme.mode == ThemeMode.light ? #ffffff : Tokens.color-surface-1;
        border-color: root.invalid ? Tokens.color-destructive
            : input.has-focus ? Tokens.color-ring
            : Tokens.color-border-hairline;
        border-width: 1px;
        border-radius: root.border-radius;
        opacity: root.enabled ? 1.0 : 0.5;

        focus-area := TouchArea {
            mouse-cursor: MouseCursor.text;
            pointer-event(ev) => {
                if (root.enabled
                    && ev.button == PointerEventButton.left
                    && ev.kind == PointerEventKind.down) {
                    root.pointer-focus = true;
                }
            }
            clicked => { input.focus(); }
        }

        icon := Image {
            visible: root.has-icon;
            source: root.icon;
            x: Dir.x(10 * Tokens.unit, self.width, parent.width);
            width: root.has-icon ? 1.1rem : 0;
            height: self.width;
            y: (parent.height - self.height) / 2;
            colorize: Tokens.color-muted-foreground;
            accessible-role: none;
        }

        input := TextInput {
            // from the start edge, the right one for right-to-left languages
            property <length> offset: root.has-icon ? 10 * Tokens.unit + icon.width + 8 * Tokens.unit : 12 * Tokens.unit;
            x: Dir.x(self.offset, self.width, parent.width);
            y: 0;
            width: (reveal.visible ? parent.width - reveal.width - 4 * Tokens.unit : parent.width - 12 * Tokens.unit) - self.offset;
            horizontal-alignment: Dir.text-start;
            height: parent.height;
            text <=> root.text;
            color: Tokens.color-foreground;
            selection-background-color: TdnStyle.accent.transparentize(0.6);
            font-size: Tokens.typography-body-size;
            single-line: true;
            read-only: root.read-only || !root.enabled;
            enabled: root.enabled && Modal.open == root.in-dialog;
            input-type: root.password && !root.revealed ? InputType.password : InputType.text;
            vertical-alignment: center;
            // exposed through the wrapper instead, see `accessible-role` above
            accessible-role: none;
            edited => { root.edited(self.text); }
            accepted => { root.accepted(self.text); }
            key-pressed(event) => {
                root.pointer-focus = false;
                // Enter is `accepted`, which moves on, so a held one would go through the next pages too
                if event.text == Key.Return && event.repeat { return accept; }
                root.key-pressed(event)
            }
            init => { if (root.auto-focus) { self.focus(); } }
        }

        // not over text being composed with an input method, which isn't in `text` yet
        if root.text == "" && input.preedit-text == "": Text {
            x: input.x;
            y: 0;
            width: input.width;
            height: parent.height;
            text: root.placeholder;
            horizontal-alignment: Dir.text-start;
            color: Tokens.color-muted-foreground;
            font-size: Tokens.typography-body-size;
            vertical-alignment: center;
            overflow: elide;
            // `accessible-placeholder-text` is set on the wrapper already
            accessible-role: none;
        }

        // show/hide toggle for password fields, a Tab stop after the text so it works without a mouse
        reveal := Rectangle {
            visible: root.password;
            width: root.password ? parent.height : 0;
            height: parent.height;
            x: Dir.x(parent.width - self.width, self.width, parent.width);
            border-radius: Tokens.radius-md;
            accessible-role: button;
            accessible-label: root.reveal-label;
            accessible-enabled: root.enabled;
            accessible-checkable: true;
            accessible-checked: root.revealed;
            accessible-action-default => {
                if root.enabled && Modal.open == root.in-dialog { root.revealed = !root.revealed; }
            }

            reveal-focus := FocusScope {
                enabled: root.password && root.enabled && Modal.open == root.in-dialog;
                // a click set it, so it can be stale when Tab comes back here from elsewhere
                focus-gained(reason) => {
                    if reason == FocusReason.tab-navigation { root.reveal-pointer-focus = false; }
                }
                key-pressed(event) => {
                    root.reveal-pointer-focus = false;
                    if event.text == Key.Return || event.text == " " {
                        if !event.repeat { root.revealed = !root.revealed; }
                        return accept;
                    }
                    reject
                }
            }

            Image {
                source: @image-url("../data/icons/eye-open-negative-filled-symbolic.svg");
                width: 1.1rem;
                height: self.width;
                colorize: root.revealed ? Tokens.color-foreground : Tokens.color-muted-foreground;
                accessible-role: none;
            }

            // doesn't take focus, so clicking it leaves the cursor in the text
            TouchArea {
                enabled: root.enabled;
                mouse-cursor: pointer;
                pointer-event(ev) => {
                    if ev.kind == PointerEventKind.down { root.reveal-pointer-focus = true; }
                }
                clicked => { root.revealed = !root.revealed; }
            }

            if reveal-focus.has-focus && !root.reveal-pointer-focus: FocusRing {
                host-width: parent.width;
                host-height: parent.height;
                inset: true;
                offset: 3px;
                radius: Tokens.radius-sm;
            }
        }

        // outer focus ring — keyboard-only, drawn last so it's visually unclipped
        if input.has-focus && !root.pointer-focus: FocusRing {
            host-width: parent.width;
            host-height: parent.height;
        }
    }
}

// a selectable row in a list (languages, keymaps, …)
export component TdnListRow inherits Rectangle {
    in property <string> text;
    // extra text on the trailing side, e.g. a language's native name
    in property <string> secondary;
    in property <bool> selected;
    // the row the arrow keys are on, for lists driven from a search field
    in property <bool> highlighted;
    // a Tab stop of its own, activated with Enter or Space, for lists with no search field
    // driving them
    in property <bool> focusable;
    // whether this is part of a dialog, see `Modal`
    in property <bool> in-dialog;
    callback clicked;

    property <bool> pointer-focus;

    forward-focus: focus;
    accessible-role: list-item;
    accessible-label: root.secondary == "" ? root.text : root.text + ", " + root.secondary;
    accessible-item-selectable: true;
    accessible-item-selected: root.selected;
    accessible-action-default => { if Modal.open == root.in-dialog { root.clicked(); } }

    height: 2.25rem;
    border-radius: Tokens.radius-sm;
    background: root.selected ? TdnStyle.accent
        : area.has-hover || root.highlighted ? Tokens.color-accent
        : transparent;

    focus := FocusScope {
        enabled: root.focusable && Modal.open == root.in-dialog;
        // a click set it, so it can be stale when Tab comes back here from elsewhere
        focus-gained(reason) => {
            if reason == FocusReason.tab-navigation { root.pointer-focus = false; }
        }
        key-pressed(event) => {
            root.pointer-focus = false;
            if event.text == Key.Return || event.text == " " {
                if !event.repeat { root.clicked(); }
                return accept;
            }
            reject
        }
    }

    HorizontalLayout {
        padding-left: 0.75rem;
        padding-right: 0.75rem;
        spacing: 1rem;

        TdnText {
            text: root.text;
            horizontal-alignment: Dir.text-start;
            // or a layout never shrinks it below its full width, and it can't elide
            min-width: 0;
            overflow: elide;
            color: root.selected ? TdnStyle.accent-foreground : Tokens.color-foreground;
            accessible-role: none;
        }

        if root.secondary != "": TdnText {
            layout-order: Dir.order(1);
            text: root.secondary;
            horizontal-alignment: Dir.text-end;
            horizontal-stretch: 0;
            color: root.selected ? TdnStyle.accent-foreground : Tokens.color-muted-foreground;
            accessible-role: none;
        }
    }

    area := TouchArea {
        mouse-cursor: pointer;
        pointer-event(ev) => {
            if ev.kind == PointerEventKind.down { root.pointer-focus = true; }
        }
        clicked => { root.clicked(); }
    }

    // inset, the rows sit flush against each other and the edge of their list
    if focus.has-focus && !root.pointer-focus: FocusRing {
        host-width: parent.width;
        host-height: parent.height;
        inset: true;
        offset: 0;
        radius: Tokens.radius-sm;
    }
}

// picks one of `options`, the list opens below it and Up and Down change the choice while focused
export component TdnSelect inherits Rectangle {
    in property <[string]> options;
    in-out property <int> index;
    in property <bool> enabled: true;
    // whether this is part of a dialog, see `Modal`
    in property <bool> in-dialog;
    // accessible name, as the visible label is usually a `TdnField`'s
    in property <string> label;
    callback changed(int);
    // when it gets focus or opens, with where it is in the window, so a scrolling list can show it
    callback focus-in(/* y */ length, /* height */ length);

    property <bool> open;
    property <bool> pointer-focus;
    property <bool> has-focus: focus.has-focus;

    changed has-focus => {
        if self.has-focus { root.focus-in(root.absolute-position.y, root.height); }
    }
    changed open => {
        if self.open { root.focus-in(root.absolute-position.y, root.height); }
    }

    function pick(i: int) {
        if i >= 0 && i < root.options.length && i != root.index {
            root.index = i;
            root.changed(i);
        }
    }

    forward-focus: focus;
    accessible-role: combobox;
    accessible-label: root.label;
    accessible-value: root.options[root.index];
    accessible-enabled: root.enabled;
    accessible-expandable: true;
    accessible-expanded: root.open;
    accessible-action-expand => {
        if root.enabled && Modal.open == root.in-dialog { root.open = !root.open; }
    }

    VerticalLayout {
        spacing: 0.25rem;

        header := Rectangle {
            height: Tokens.density-input;
            border-radius: Tokens.radius-md;
            border-width: 1px;
            border-color: Tokens.color-border-hairline-strong;
            background: area.has-hover && root.enabled ? Tokens.color-accent : Tokens.color-card;
            opacity: root.enabled ? 1 : 0.5;

            focus := FocusScope {
                enabled: root.enabled && Modal.open == root.in-dialog;
                // a click set it, so it can be stale when Tab comes back here from elsewhere
                focus-gained(reason) => {
                    if reason == FocusReason.tab-navigation { root.pointer-focus = false; }
                }
                key-pressed(event) => {
                    root.pointer-focus = false;
                    if event.text == " " || event.text == Key.Return {
                        if !event.repeat { root.open = !root.open; }
                        return accept;
                    }
                    if event.text == Key.DownArrow { root.pick(root.index + 1); return accept; }
                    if event.text == Key.UpArrow { root.pick(root.index - 1); return accept; }
                    if event.text == Key.Home { root.pick(0); return accept; }
                    if event.text == Key.End { root.pick(root.options.length - 1); return accept; }
                    if event.text == Key.Escape && root.open {
                        root.open = false;
                        return accept;
                    }
                    reject
                }
                // tabbing away leaves the list open otherwise. Not on clicks, one on an option
                // must still reach it
                focus-lost(reason) => {
                    if reason == FocusReason.tab-navigation { root.open = false; }
                }
            }

            HorizontalLayout {
                padding-left: 0.75rem;
                padding-right: 0.6rem;
                spacing: 0.5rem;

                // takes the free space, so the arrow sits at the end
                TdnText {
                    text: root.options[root.index];
                    horizontal-stretch: 1;
                    min-width: 0;
                    horizontal-alignment: Dir.text-start;
                    overflow: elide;
                }

                VerticalLayout {
                    layout-order: Dir.order(1);
                    alignment: center;
                    horizontal-stretch: 0;

                    Icon {
                        commands: root.open ? LucidePaths.chevron-up : LucidePaths.chevron-down;
                        size: 1rem;
                        tint: Tokens.color-muted-foreground;
                    }
                }
            }

            area := TouchArea {
                enabled: root.enabled;
                mouse-cursor: pointer;
                pointer-event(ev) => {
                    if ev.kind == PointerEventKind.down { root.pointer-focus = true; }
                }
                clicked => {
                    root.open = !root.open;
                    focus.focus();
                }
            }

            if focus.has-focus && !root.pointer-focus: FocusRing {
                host-width: parent.width;
                host-height: parent.height;
            }
        }

        if root.open && root.enabled: Rectangle {
            border-radius: Tokens.radius-md;
            border-width: 1px;
            border-color: Tokens.color-border-hairline-strong;
            background: Tokens.color-card;

            VerticalLayout {
                padding: 0.25rem;

                for option[i] in root.options: TdnListRow {
                    in-dialog: root.in-dialog;
                    text: option;
                    selected: i == root.index;
                    clicked => {
                        root.pick(i);
                        root.open = false;
                    }
                }
            }
        }
    }
}

// a labelled form field, with the input as its child
export component TdnField inherits VerticalLayout {
    in property <string> label;
    in property <bool> required;
    // shown below the input, replaced by `error` when that is set
    in property <string> help;
    in property <string> error;
    // the text shown under the input, for the input's `description`
    out property <string> description: root.error != "" ? root.error : root.help;
    callback label-clicked;

    spacing: 0.4rem;

    // `Label` sizes itself to its text, which would cap the whole field at that width
    HorizontalLayout {
        alignment: Dir.start;

        Label {
            text: root.label;
            variant: root.required ? LabelVariant.required : LabelVariant.default;
            clicked => { root.label-clicked(); }
        }
    }

    @children

    if root.help != "" || root.error != "": TdnText {
        text: root.error != "" ? root.error : root.help;
        color: root.error != "" ? Tokens.color-destructive : Tokens.color-muted-foreground;
        font-size: Tokens.typography-body-sm-size;
        horizontal-alignment: Dir.text-start;
        wrap: word-wrap;
    }
}

// a bordered row with a label and a switch, e.g. "Install Drivers"
export component TdnToggleRow inherits Rectangle {
    in property <string> text;
    // set it from what `toggled` changes, rather than `<=>`, so it keeps following the setting
    in property <bool> checked;
    callback toggled(bool);
    // fired on Enter, while Space toggles
    callback accepted();
    // whether this is part of a dialog, see `Modal`
    in property <bool> in-dialog;
    // when it gets focus, with where it is in the window, so a scrolling list can show it
    callback focus-in(/* y */ length, /* height */ length);

    property <bool> pointer-focus;
    property <bool> has-focus: focus.has-focus;

    changed has-focus => {
        if self.has-focus { root.focus-in(root.absolute-position.y, root.height); }
    }

    function toggle() {
        root.toggled(!root.checked);
    }

    forward-focus: focus;
    accessible-role: switch;
    accessible-label: root.text;
    accessible-checkable: true;
    accessible-checked: root.checked;
    accessible-action-default => { if Modal.open == root.in-dialog { root.toggle(); } }

    // taller when a long translation wraps
    min-height: 3rem;
    border-radius: Tokens.radius-lg;
    border-width: 1px;
    border-color: Tokens.color-border-hairline-strong;
    background: Tokens.color-card;

    focus := FocusScope {
        enabled: Modal.open == root.in-dialog;
        // a click set it, so it can be stale when Tab comes back here from elsewhere
        focus-gained(reason) => {
            if reason == FocusReason.tab-navigation { root.pointer-focus = false; }
        }
        key-pressed(event) => {
            root.pointer-focus = false;
            if event.text == " " {
                if !event.repeat { root.toggle(); }
                return accept;
            }
            if event.text == Key.Return {
                if !event.repeat { root.accepted(); }
                return accept;
            }
            reject
        }
    }

    HorizontalLayout {
        padding-left: 0.85rem;
        padding-right: 0.85rem;
        // room around a wrapped label
        padding-top: 0.4rem;
        padding-bottom: 0.4rem;
        spacing: 1rem;

        TdnText {
            text: root.text;
            horizontal-alignment: Dir.text-start;
            vertical-alignment: center;
            font-weight: Tokens.typography-weight-medium;
            wrap: word-wrap;
            // or a layout never lets it be narrower than its whole text on one line
            min-width: 0;
        }

        VerticalLayout {
            layout-order: Dir.order(1);
            alignment: center;

            Rectangle {
                width: 2.4rem;
                height: 1.3rem;
                border-radius: self.height / 2;
                background: root.checked ? Tokens.color-primary : Tokens.color-border-hairline-strong;
                animate background { duration: Tokens.motion-fast; }

                Rectangle {
                    width: parent.height - 0.3rem;
                    height: self.width;
                    y: 0.15rem;
                    // on is toward the end, the left for right-to-left languages
                    x: Dir.x(root.checked ? parent.width - self.width - 0.15rem : 0.15rem, self.width, parent.width);
                    border-radius: self.width / 2;
                    background: root.checked ? Tokens.color-primary-foreground : Tokens.color-background;
                    animate x {
                        duration: Tokens.motion-fast;
                        easing: Tokens.motion-easing-standard;
                    }
                }
            }
        }
    }

    TouchArea {
        mouse-cursor: pointer;
        pointer-event(ev) => {
            if ev.kind == PointerEventKind.down { root.pointer-focus = true; }
        }
        clicked => { root.toggle(); }
    }

    if focus.has-focus && !root.pointer-focus: FocusRing {
        host-width: parent.width;
        host-height: parent.height;
        radius: Tokens.radius-lg + self.offset;
    }
}

// an indeterminate progress ring, standing still with reduced motion
export component TdnSpinner inherits Rectangle {
    in property <color> tint: Tokens.color-foreground;
    in property <length> stroke: 2.5 * Tokens.unit;

    // `animation-tick()` is only read while it turns, so a still spinner doesn't redraw every frame
    property <angle> start: Tokens.reduce-motion ? -90deg : mod(animation-tick() / 1ms * 0.36deg, 360deg);
    property <length> r: (min(self.width, self.height) - self.stroke) / 2;

    width: 1.5rem;
    height: self.width;
    accessible-role: progress-indicator;

    Path {
        width: 100%;
        height: 100%;
        viewbox-x: 0;
        viewbox-y: 0;
        viewbox-width: root.width / 1px;
        viewbox-height: root.height / 1px;
        stroke: root.tint;
        stroke-width: root.stroke;
        stroke-line-cap: round;

        // a 270° arc, rotating unless motion is reduced
        MoveTo {
            x: (root.width / 2 + root.r * cos(root.start)) / 1px;
            y: (root.height / 2 + root.r * sin(root.start)) / 1px;
        }

        ArcTo {
            x: (root.width / 2 + root.r * cos(root.start + 270deg)) / 1px;
            y: (root.height / 2 + root.r * sin(root.start + 270deg)) / 1px;
            radius-x: root.r / 1px;
            radius-y: root.r / 1px;
            large-arc: true;
            sweep: true;
        }
    }
}

// wi-fi signal icon with `strength` (0–3) of its three arcs lit
export component TdnWifiIcon inherits Rectangle {
    in property <int> strength: 3;
    in property <color> tint: Tokens.color-foreground;

    width: 1.25rem;
    height: self.width;
    accessible-role: none;

    Icon {
        commands: LucidePaths.wifi-dot;
        size: parent.width;
        tint: root.tint;
    }

    Icon {
        commands: LucidePaths.wifi-1;
        size: parent.width;
        tint: root.strength >= 1 ? root.tint : root.tint.transparentize(0.75);
    }

    Icon {
        commands: LucidePaths.wifi-2;
        size: parent.width;
        tint: root.strength >= 2 ? root.tint : root.tint.transparentize(0.75);
    }

    Icon {
        commands: LucidePaths.wifi-3;
        size: parent.width;
        tint: root.strength >= 3 ? root.tint : root.tint.transparentize(0.75);
    }
}

// a small square icon button, the same size as `TdnStatusIcon`, for actions in a list row
export component TdnIconButton inherits Rectangle {
    // Lucide path commands, see `LucidePaths`
    in property <string> icon;
    // what it does, for screen readers
    in property <string> label;
    in property <bool> enabled: true;
    // shows a spinner and ignores presses, but keeps keyboard focus, unlike `enabled`
    in property <bool> busy;
    // more about it, such as why the last try failed, for screen readers
    in property <string> description;
    // whether this is part of a dialog, see `Modal`
    in property <bool> in-dialog;
    out property <bool> has-focus: focus.has-focus;
    callback clicked;

    property <bool> pointer-focus;
    property <bool> active: root.enabled && !root.busy;

    forward-focus: focus;
    accessible-role: button;
    accessible-label: root.label;
    accessible-description: root.description;
    accessible-enabled: root.active;
    accessible-action-default => {
        if root.active && Modal.open == root.in-dialog { root.press(); }
    }

    // presses it, and if that opened a dialog, the focus comes back here once it closes
    function press() {
        root.clicked();
        if !root.in-dialog { opener.opened(); }
    }

    // drawn at text size, like buttons, see `Tokens.text-scale`
    width: self.height;
    height: 1.6rem * Tokens.text-scale;
    border-radius: Tokens.radius-sm;
    background: root.busy ? transparent
        : !root.enabled ? TdnStyle.accent.transparentize(0.92)
        : area.pressed ? TdnStyle.accent.transparentize(0.6)
        : area.has-hover ? TdnStyle.accent.transparentize(0.75)
        : TdnStyle.accent.transparentize(0.85);
    animate background { duration: Tokens.motion-fast; }

    // stays enabled while busy, since disabling the focused item drops focus
    focus := FocusScope {
        enabled: (root.enabled || root.busy) && Modal.open == root.in-dialog;
        // a click set it, so it can be stale when Tab comes back here from elsewhere
        focus-gained(reason) => {
            if reason == FocusReason.tab-navigation { root.pointer-focus = false; }
        }
        key-pressed(event) => {
            root.pointer-focus = false;
            if event.text == Key.Return || event.text == " " {
                if !event.repeat && root.active { root.press(); }
                return accept;
            }
            reject
        }
    }

    opener := DialogOpener {
        restore => { focus.focus(); }
    }

    if root.busy: TdnSpinner {
        width: parent.height * 0.7;
    }

    if !root.busy: Icon {
        commands: root.icon;
        size: parent.height * 0.6;
        tint: root.enabled ? TdnStyle.accent : Tokens.color-muted-foreground;
    }

    area := TouchArea {
        enabled: root.active;
        mouse-cursor: root.active ? pointer : default;
        pointer-event(ev) => {
            if ev.kind == PointerEventKind.down { root.pointer-focus = true; }
        }
        clicked => { root.press(); }
    }

    if focus.has-focus && !root.pointer-focus: FocusRing {
        host-width: parent.width;
        host-height: parent.height;
    }
}

// a small square status icon: a green check when `ok`, a grey cross when not
export component TdnStatusIcon inherits Rectangle {
    in property <bool> ok: true;
    // the status, for screen readers, and anything more about it
    in property <string> label;
    in property <string> description;

    accessible-role: image;
    accessible-label: root.label;
    accessible-description: root.description;

    width: self.height;
    height: 1.6rem * Tokens.text-scale;
    border-radius: Tokens.radius-sm;
    background: root.ok ? Tokens.color-affirm.transparentize(0.75) : Tokens.color-secondary;

    Icon {
        commands: root.ok ? LucidePaths.check : LucidePaths.x-mark;
        size: parent.height * 0.6;
        tint: root.ok ? Tokens.color-foreground : Tokens.color-muted-foreground;
    }
}

// a modal dialog over its parent, which should fill the window, with the content as children
export component TdnDialog inherits Rectangle {
    in property <string> title;
    in property <length> dialog-width: 22rem;
    // fired on Escape, or whatever else should close it
    callback dismissed;

    background: #00000099;

    // keeps clicks from reaching what's underneath
    TouchArea { }

    FocusScope {
        // keys bubble up to it, it needn't be a Tab stop
        focus-on-tab-navigation: false;
        key-pressed(event) => {
            if event.text == Key.Escape {
                root.dismissed();
                return accept;
            }
            reject
        }

        Card {
            x: (root.width - self.width) / 2;
            y: (root.height - self.height) / 2;
            width: min(root.dialog-width, root.width - 2rem);
            // never taller than the window, a `ScrollView` inside then gets what's left
            height: min(content.preferred-height, root.height - 2rem);
            background: Tokens.color-background;
            card-radius: lg;

            content := VerticalLayout {
                padding: 1.25rem;
                spacing: 1rem;
                // Slint has no dialog role, so a named group like `TdnPage`'s, which screen
                // readers announce when the focus moves into the dialog
                accessible-role: groupbox;
                accessible-label: root.title;

                TdnText {
                    text: root.title;
                    font-size: 1.4 * Tokens.text-rem;
                    font-weight: 500;
                    horizontal-alignment: Dir.text-start;
                    wrap: word-wrap;
                }

                @children
            }
        }
    }
}
