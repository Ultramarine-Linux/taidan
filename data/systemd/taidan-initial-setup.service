[Unit]
Description=Taidan Initial Setup configuration program
After=livesys.service plymouth-quit-wait.service
After=systemd-vconsole-setup.service
After=systemd-user-sessions.service
# getty-pre.target is a pasive target, we need to request it before we can use it
Wants=getty-pre.target
Wants=dbus.socket systemd-logind.service
After=dbus.socket systemd-logind.service
# prevent getty from running on any consoles before we are done
Before=getty-pre.target
Before=display-manager.service
Conflicts=plymouth-quit-wait.service initial-setup-text.service initial-setup-graphical.service initial-setup.service
ConditionKernelCommandLine=!rd.live.image
# also here, not only on the reconfiguration unit: units it pulls in with Requires= start even
# when its own conditions fail, so without these the OOBE would run on every boot it's enabled
ConditionPathExists=|/var/.unconfigured
ConditionPathExists=|/.unconfigured

[Service]
Type=oneshot
TimeoutSec=0
RemainAfterExit=no
# the taidan user's home, /usr/lib/taidan, isn't writable, so the session (KWin, Taidan and
# kwriteconfig6 changing KWin's config for accessibility and the keymap) keeps its config here.
# it's gone when the unit stops, so every run starts from /usr/share/taidan/session-config.
RuntimeDirectory=taidan
RuntimeDirectoryMode=0700
Environment=XDG_CONFIG_HOME=%t/taidan/config
Environment=XDG_CACHE_HOME=%t/taidan/cache
Environment=XDG_DATA_HOME=%t/taidan/data
Environment=XDG_STATE_HOME=%t/taidan/state
# the logs have usernames, SSIDs and the like in them. systemd opens them (creating them 0644) for
# every command, so this goes first, before anything is written to them. not UMask=: pkexec keeps
# the umask, and everything taidan creates as root (repo files, directories `install -D` makes…)
# would end up unreadable to everyone else
ExecStartPre=-+chmod 0600 /var/log/taidan.stdout.log /var/log/taidan.stderr.log
# as root, plymouthd ignores anyone else
ExecStartPre=-+/bin/plymouth quit
ExecStartPre=+sh -c "exec chvt 7"
ExecStartPre=cp -rT /usr/share/taidan/session-config %t/taidan/config
# the polkit rules that let the OOBE run things as root only exist while this unit runs. /run is
# a tmpfs, so they're also gone if the machine goes down mid-setup. polkitd watches the directory,
# but the reload makes them apply right away even if /run/polkit-1/rules.d didn't exist yet.
ExecStartPre=+install -Dpm644 /usr/share/taidan/polkit/100-taidan.rules -t /run/polkit-1/rules.d/
ExecStartPre=-+systemctl try-reload-or-restart polkit.service
# the user the captive portal browser runs as, so a page the network serves never runs as taidan,
# who may run anything as root. only for as long as the OOBE runs
ExecStartPre=+sh -c "id taidan-portal >/dev/null 2>&1 || exec useradd --system --user-group --no-create-home --home-dir /run/taidan-portal --shell /usr/sbin/nologin --comment 'Taidan captive portal browser' taidan-portal"
# not `shutdown`: logind refuses the power key while that's blocked, which left holding the
# button down as the only way out. shutting down stops this unit first, like any other.
# start-taidan runs the KWin session and restarts it if taidan crashes. if that keeps failing it
# shows a message on tty7 and never exits, so the display manager and the gettys, ordered after
# this oneshot, don't start on a system that isn't set up.
ExecStart=systemd-inhibit \
 --who="taidan" \
 --what=handle-lid-switch:sleep \
 --why="Taidan Initial Setup is running" \
 --mode=block \
 sh /usr/libexec/start-taidan
ExecStopPost=+sh -c "exec chvt 1"
ExecStopPost=+rm -f /run/polkit-1/rules.d/100-taidan.rules
ExecStopPost=-+systemctl try-reload-or-restart polkit.service
ExecStopPost=-+systemctl stop taidan-portal.service
ExecStopPost=-+userdel taidan-portal
StandardOutput=append:/var/log/taidan.stdout.log
StandardError=append:/var/log/taidan.stderr.log
User=taidan
UtmpIdentifier=tty7
UtmpMode=user
TTYPath=/dev/tty7
TTYReset=yes
TTYVHangup=yes
TTYVTDisallocate=yes
StandardInput=tty-fail
PAMName=taidan

[Install]
WantedBy=graphical.target
WantedBy=multi-user.target
