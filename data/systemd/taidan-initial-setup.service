[Unit]
Description=Taidan Initial Setup configuration program
After=livesys.service plymouth-quit-wait.service
After=systemd-vconsole-setup.service
After=systemd-user-sessions.service
# getty-pre.target is a pasive target, we need to request it before we can use it
Wants=getty-pre.target
Wants=dbus.socket systemd-logind.service
After=dbus.socket systemd-logind.service
# prevent getty from running on any consoles before we are done
Before=getty-pre.target
Before=display-manager.service
Conflicts=plymouth-quit-wait.service initial-setup-text.service initial-setup-graphical.service initial-setup.service
ConditionKernelCommandLine=!rd.live.image
# units pulled in with Requires= still start when the requiring unit's conditions fail
ConditionPathExists=|/var/.unconfigured
ConditionPathExists=|/.unconfigured

[Service]
Type=oneshot
TimeoutSec=0
RemainAfterExit=no
RuntimeDirectory=taidan
RuntimeDirectoryMode=0700
Environment=XDG_CONFIG_HOME=%t/taidan/config
Environment=XDG_CACHE_HOME=%t/taidan/cache
Environment=XDG_DATA_HOME=%t/taidan/data
Environment=XDG_STATE_HOME=%t/taidan/state
# the logs hold usernames and SSIDs. not UMask= because pkexec passes it on to everything run as root
ExecStartPre=-+chmod 0600 /var/log/taidan.stdout.log /var/log/taidan.stderr.log
# plymouthd ignores anyone but root
ExecStartPre=-+/bin/plymouth quit
ExecStartPre=+sh -c "exec chvt 7"
ExecStartPre=cp -rT /usr/share/taidan/session-config %t/taidan/config
# polkitd only picks up a newly created /run/polkit-1/rules.d on reload
ExecStartPre=+install -Dpm644 /usr/share/taidan/polkit/100-taidan.rules -t /run/polkit-1/rules.d/
ExecStartPre=-+systemctl try-reload-or-restart polkit.service
ExecStartPre=+sh -c "id taidan-portal >/dev/null 2>&1 || exec useradd --system --user-group --no-create-home --home-dir /run/taidan-portal --shell /usr/sbin/nologin --comment 'Taidan captive portal browser' taidan-portal"
# not `shutdown`, logind refuses the power key while that's blocked
ExecStart=systemd-inhibit \
 --who="taidan" \
 --what=handle-lid-switch:sleep \
 --why="Taidan Initial Setup is running" \
 --mode=block \
 sh /usr/libexec/start-taidan
ExecStopPost=+sh -c "exec chvt 1"
ExecStopPost=+rm -f /run/polkit-1/rules.d/100-taidan.rules
ExecStopPost=-+systemctl try-reload-or-restart polkit.service
ExecStopPost=-+systemctl stop taidan-portal.service
ExecStopPost=-+userdel taidan-portal
StandardOutput=append:/var/log/taidan.stdout.log
StandardError=append:/var/log/taidan.stderr.log
User=taidan
UtmpIdentifier=tty7
UtmpMode=user
TTYPath=/dev/tty7
TTYReset=yes
TTYVHangup=yes
TTYVTDisallocate=yes
StandardInput=tty-fail
PAMName=taidan

[Install]
WantedBy=graphical.target
WantedBy=multi-user.target
